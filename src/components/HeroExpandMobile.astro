---
/* src/components/HeroExpandMobile.astro */
// Telefon: klatki przycięte do pionowego środka (810×1080 → 648×864) — ok. 60% lżejsze
const staticPlaceholder = "/sequence-m/000001.webp";

const stats = [
  {
    title: "Doświadczenie",
    heading: "12 lat w branży",
    description: "Projektowanie produktów dla sektorów finansowego, medycznego i zbrojeniowego."
  },
  {
    title: "Satysfakcja klientów (NPS)",
    heading: "NPS 56,4 w ING",
    description: "Wynik bankowości firmowej ING za III kwartał 2026 — bardzo dobry poziom doświadczenia klientów w wymagającym segmencie SME/MC."
  },
  {
    title: "Wpływ biznesowy",
    heading: "−20% ryzyka incydentów",
    description: "Redukcja ryzyka incydentów kolejowych o 20%, a 89% badanych użytkowników TabBox odnotowało poprawę regularności przyjmowania leków."
  },
  {
    title: "Innowacje",
    heading: "AI i przywództwo",
    description: "Wdrażanie asystentów GenAI oraz współtworzenie strategii w międzynarodowej gildii projektowej."
  }
];
---

<div class="mobile-expand block md:hidden">
  <div class="me-trigger">
    <div class="me-stage">
      <div class="me-inner">
        <img src={staticPlaceholder} class="me-static-img" alt="Kamil Wardak" width="648" height="864" loading="lazy" decoding="async" />
        <canvas id="me-canvas" class="me-canvas opacity-0"></canvas>

        <div class="me-overlay opacity-0 pointer-events-none">
          <div class="me-cards-scroll">
            {stats.map((stat, i) => (
              <div class="me-stat-card">
                <div class="me-card-label">
                  {/* Blok w kolorze labelki — zielony */}
                  <span class="reveal-block-el reveal-block-label"></span>
                  <span class="me-label-text text-[#BAF52A] text-[10px] normalcase tracking-widest font-extrabold block" data-i18n={`expand.stat.${i}.title`}>{stat.title}</span>
                </div>
                <div class="me-card-heading">
                  {/* Blok w kolorze headingu — biały */}
                  <span class="reveal-block-el reveal-block-heading"></span>
                  <h3 class="me-heading-text text-white text-xl font-bold" data-i18n={`expand.stat.${i}.heading`}>{stat.heading}</h3>
                </div>
                <div class="me-card-desc">
                  {/* Blok w kolorze opisu — stone-300 */}
                  <span class="reveal-block-el reveal-block-desc"></span>
                  <p class="me-desc-text text-stone-300 text-xs leading-relaxed font-medium" data-i18n={`expand.stat.${i}.desc`}>{stat.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .me-trigger { position: relative; background: #0c0a09; }

  .me-stage {
    /* svh = wysokość przy widocznym pasku adresu — nie zmienia się, gdy pasek się chowa */
    width: 100%; height: 100vh; height: 100svh;
    background: #0c0a09; overflow: hidden;
  }

  .me-inner {
    width: 100%; height: 100%;
    position: relative; background: #000; overflow: hidden;
  }

  .me-static-img, .me-canvas {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center; display: block;
  }

  .me-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(12,10,9,0.4) 0%, rgba(12,10,9,0.92) 100%);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    /* Góra: wysokość przyklejonego nagłówka (h-20 = 5rem) + odstęp, żeby pierwszy kafel nie wchodził pod menu */
    padding: calc(5rem + 1rem) 0 1.5rem; z-index: 20;
    /* Kafle są tylko do czytania — dotyk zawsze przewija stronę */
    pointer-events: none;
  }

  .me-cards-scroll {
    width: 100%; max-height: 100%;
    /* Bez wewnętrznego przewijania: przechwytywało gesty i blokowało przewijanie strony */
    overflow: hidden;
    padding: 0 1.25rem;
    display: flex; flex-direction: column; gap: 0.75rem;
  }

  .me-stat-card {
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    padding: 1.25rem; border-radius: 1.25rem;
    border: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 15px 35px rgba(0,0,0,0.6);
    flex-shrink: 0;
    /* Kafel jako całość wjeżdża fade+up */
    opacity: 0; transform: translateY(16px);
    will-change: opacity, transform;
  }

  /* Wiersze tekstu — relative + overflow dla block reveal */
  .me-card-label,
  .me-card-heading,
  .me-card-desc {
    position: relative; overflow: hidden;
    display: block; margin-bottom: 0.35rem;
  }
  .me-card-desc { margin-bottom: 0; }

  /* Bloki zasłaniające — każdy w kolorze swojego tekstu */
  .reveal-block-el {
    position: absolute; inset: 0;
    transform: scaleX(0);
    transform-origin: left center;
    z-index: 2; display: block; pointer-events: none;
  }
  .reveal-block-label   { background: #BAF52A; }   /* zielony — kolor labela */
  .reveal-block-heading { background: #ffffff; }   /* biały — kolor headingu */
  .reveal-block-desc    { background: #a8a29e; }   /* stone-300 — kolor opisu */

  /* Teksty schowane przed animacją */
  .me-label-text,
  .me-heading-text,
  .me-desc-text {
    opacity: 0; display: block;
    position: relative; z-index: 1;
  }

  /* Kompaktowe kafle — wszystkie 4 muszą się zmieścić bez przewijania (wysokość przy widocznym pasku adresu) */
  @media (max-height: 780px), (max-width: 380px) {
    .me-stat-card { padding: 0.875rem 1rem; border-radius: 1rem; }
    .me-stat-card h3 { font-size: 1.05rem; margin-bottom: 0.15rem; }
    .me-stat-card p  { font-size: 0.72rem; line-height: 1.45; }
    .me-cards-scroll { gap: 0.5rem; }
    .me-overlay { padding: calc(5rem + 0.5rem) 0 1rem; }
  }
  /* Bardzo niskie ekrany — bez opisów, zostają tytuł i liczba */
  @media (max-height: 600px) {
    .me-card-desc { display: none; }
    .me-stat-card { padding: 0.75rem 1rem; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { createFrameSequence } from '../utils/frameSequence';
  gsap.registerPlugin(ScrollTrigger);
  // Pokazanie/schowanie paska adresu nie przelicza przypięcia (to powodowało zacinanie)
  ScrollTrigger.config({ ignoreMobileResize: true });

  const mm = gsap.matchMedia();

  // Przy prefers-reduced-motion sekcja zostaje statyczna (stan końcowy w global.css)
  mm.add("(max-width: 767px) and (prefers-reduced-motion: no-preference)", () => {
    const frameCount = 48;
    const framePath = (i: number) => `/sequence-m/${i.toString().padStart(6, '0')}.webp`;

    const trigger   = document.querySelector('.me-trigger') as HTMLElement;
    const stage     = document.querySelector('.me-stage') as HTMLElement;
    const canvas    = document.getElementById('me-canvas') as HTMLCanvasElement;
    const staticImg = document.querySelector('.me-static-img') as HTMLImageElement;
    const overlay   = document.querySelector('.me-overlay') as HTMLElement;
    const statCards = document.querySelectorAll('.me-stat-card');

    if (!trigger || !stage || !canvas || !staticImg) return;

    // Klatki pobierają się dopiero, gdy sekcja zbliża się do ekranu
    const { seq, render, cacheSize, destroy } = createFrameSequence({
      canvas, firstFrame: staticImg, trigger, frameCount, framePath,
    });

    /**
     * Block Reveal dla jednego kafla mobilnego.
     * Linie: label → heading → desc, każda odsłaniana osobno.
     */
    const buildCardReveal = (card: Element): gsap.core.Timeline => {
      const tl = gsap.timeline();
      const rows = card.querySelectorAll<HTMLElement>('.me-card-label, .me-card-heading, .me-card-desc');

      rows.forEach((row, i) => {
        const block = row.querySelector<HTMLElement>('.reveal-block-el');
        const text  = row.querySelector<HTMLElement>('.me-label-text, .me-heading-text, .me-desc-text');
        if (!block || !text) return;

        tl.to(block, {
          scaleX: 1, duration: 0.28,
          ease: 'power2.inOut', transformOrigin: 'left center',
        }, i * 0.08)
        .set(text, { opacity: 1 }, '>')
        .to(block, {
          scaleX: 0, duration: 0.28,
          ease: 'power2.inOut', transformOrigin: 'right center',
        });
      });

      return tl;
    };

    const buildTimeline = () => {
      cacheSize();
      render();

      const masterTL = gsap.timeline({
        scrollTrigger: {
          trigger: trigger,
          pin: stage,
          start: 'top top',
          // Wariant A (audyt UX pkt 4): krótsze przypięcie — było '+=250%'
          end: '+=120%',
          scrub: 0.8,
          pinSpacing: true,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        }
      });

      // Faza 1 — sekwencja klatek
      masterTL
        .set(canvas,    { opacity: 1 }, 0.05)
        .set(staticImg, { opacity: 0 }, 0.05)
        .to(seq, {
          frame: frameCount, snap: 'frame',
          duration: 2, ease: 'none', onUpdate: render,
        }, 0);

      // Faza 2 — overlay
      masterTL.to(overlay, {
        opacity: 1, duration: 0.8, ease: 'power2.out',
      }, '>-0.2');

      // Faza 3 — kafle wjeżdżają razem (minimalny stagger)
      masterTL.addLabel('cards', '>-0.3');
      masterTL.to(statCards, {
        opacity: 1, y: 0,
        duration: 0.5, stagger: 0.06, ease: 'power3.out',
      }, 'cards');

      // Faza 4 — Block Reveal tekstu we wszystkich kaflach jednocześnie
      statCards.forEach((card) => {
        masterTL.add(buildCardReveal(card), 'cards+=0.15');
      });

      // Faza 5 — krótka chwila zatrzymania (było 1.2)
      masterTL.to({}, { duration: 0.4 });

      // Pasek adresu na telefonie zmienia wysokość okna przy każdym przewinięciu —
      // przeliczamy tylko przy zmianie szerokości (obrót ekranu); resztę robi ScrollTrigger
      let lastW = window.innerWidth;
      window.addEventListener('resize', () => {
        if (window.innerWidth === lastW) return;
        lastW = window.innerWidth;
        cacheSize(); render();
      });
      ScrollTrigger.refresh();
    };

    // Pinowanie od razu — nie czekamy na klatki, więc układ strony nie skacze
    buildTimeline();
    return destroy;
  });
</script>