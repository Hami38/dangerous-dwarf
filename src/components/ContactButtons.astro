---
/**
 * ContactButtons.astro
 *
 * Rząd przycisków kontaktowych: e-mail (zielona pigułka) + kopiuj + opcjonalnie telefon.
 * Jeden komponent dla stopki i strony /kontakt — oba miejsca wyglądają identycznie.
 */
import CopyEmailButton from './CopyEmailButton.astro';

interface Props {
  /** Przycisk z numerem telefonu (na /kontakt telefon jest w „Innych kanałach”) */
  phone?: boolean;
}

const { phone = true } = Astro.props;

const EMAIL = 'kamil.wardak97@gmail.com';
const PHONE = '+48 794 054 199';
---

<div class="contact-buttons">
  <a href={`mailto:${EMAIL}`} class="cb-email">
    <span>{EMAIL}</span>
    <span class="cb-email-icon" aria-hidden="true">
      <svg class="icon-default" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <rect width="20" height="16" x="2" y="4" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
      <svg class="icon-hover" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14m-7-7 7 7-7 7"/>
      </svg>
    </span>
  </a>

  <CopyEmailButton email={EMAIL} />

  {phone && (
    <a href={`tel:${PHONE.replace(/\s/g, '')}`} class="cb-phone">
      <span class="cb-phone-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.6 3.36 2 2 0 0 1 3.58 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 6.06 6.06l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
      </span>
      <span>{PHONE}</span>
    </a>
  )}
</div>

<style>
  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  /* E-mail — główny przycisk */
  .cb-email {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 14px 32px;
    border-radius: 9999px;
    font-size: 15px;
    font-weight: 600;
    background-color: #BAF52A;
    color: #000;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    white-space: nowrap;
    height: 52px;
    position: relative;
    overflow: hidden;
  }

  .cb-email:hover {
    background-color: #000;
    color: #BAF52A;
    box-shadow: 0 0 0 1px #BAF52A, 0 0 30px rgba(186, 245, 42, 0.2);
  }

  .cb-email-icon {
    position: relative;
    width: 18px;
    height: 18px;
    overflow: hidden;
  }

  .cb-email-icon .icon-default,
  .cb-email-icon .icon-hover {
    position: absolute;
    inset: 0;
    transition: transform 0.4s cubic-bezier(0.6, 0.01, 0.05, 0.95);
  }

  .cb-email-icon .icon-hover { transform: translateY(100%); }
  .cb-email:hover .cb-email-icon .icon-default { transform: translateY(-100%); }
  .cb-email:hover .cb-email-icon .icon-hover { transform: translateY(0); }

  /* Telefon — przycisk secondary */
  .cb-phone {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 28px;
    border-radius: 9999px;
    font-size: 15px;
    font-weight: 600;
    background-color: transparent;
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.15);
    text-decoration: none;
    transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
    white-space: nowrap;
    height: 52px;
  }

  .cb-phone:hover {
    color: #BAF52A;
    border-color: #BAF52A;
    box-shadow: 0 0 20px rgba(186, 245, 42, 0.1);
  }

  .cb-phone-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .cb-email {
      font-size: 13px;
      padding: 12px 22px;
      height: 46px;
    }

    .cb-phone {
      font-size: 13px;
      padding: 0 20px;
      height: 46px;
    }
  }
</style>
