---
import Layout from '../layouts/Layout.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import ProjectImage from '../components/ProjectImage.astro';

// Indeks wszystkich projektów (od najnowszych) — tłumaczenia: works.row.N.*
const rows = [
  { year: "2026",    name: "Konta walutowe dla firm",       sector: "Finanse",            role: "UX Expert – Interaction Design",              result: "3 procesy → 1 wniosek",      platforms: "Web · iOS · Android",  href: "/projekty/konta-walutowe" },
  { year: "2025–26", name: "BLIK dla Biznesu",           sector: "Finanse",            role: "UX Expert – Interaction Design",              result: "1 mln zł+ w 1. tygodniu",  platforms: "Web · iOS · Android",  href: "/projekty/blik-dla-biznesu" },
  { year: "2024", name: "GreenGo (Hack the Climate)",    sector: "Miasto i klimat",    role: "Lead UX & UI Designer",                       result: "Wyróżnienie PFR",          platforms: "iOS · Android",          href: "#hack-the-climate" },
  { year: "2023", name: "REID — reidentyfikacja osób",   sector: "Bezpieczeństwo",     role: "Lead UX & UI Designer",                       result: "20% ROI w 6 miesięcy",     platforms: "Web · instalacja u klienta",     href: "/projekty/reid" },
  { year: "2023", name: "TabBox — farmakoterapia",       sector: "HealthTech",         role: "Lead Product Designer",                       result: "89% badanych z poprawą",   platforms: "iOS · Android · urządzenie",   href: "/projekty/tabbox" },
  { year: "2023", name: "PGZ — anomalie morskie",        sector: "Obronność",          role: "Lead Product Designer",                       result: "Wdrożenie operacyjne",     href: "#pgz" },
  { year: "2022", name: "VTDA — asystent maszynisty",    sector: "Transport kolejowy", role: "Lead UX & UI Designer",                       result: "−20% ryzyka incydentów",   platforms: "iOS · Android · tablet",   href: "/projekty/vtda" },
];

// Projekty bez pełnego case study — opisy wyłącznie na podstawie CV
const others = [
  {
    id: "hack-the-climate",
    key: "htc",
    overline: "Miasto / Klimat",
    title: "GreenGo — aplikacja ekologicznego transportu dla Rzeszowa",
    meta: "2024 · Lead UX & UI Designer · Miasto Rzeszów, Hack the Climate (PFR)",
    link: "https://www.behance.net/gallery/195427001/GreenGo-App-Case-Study",
    image: "/images/htc/greengo_system.webp",
    imageAlt: "GreenGo — ekrany aplikacji: punkty za ekologiczne przejazdy, nagrody i zaoszczędzone CO₂",
    desc: "Aplikacja mobilna zachęcająca mieszkańców Rzeszowa do wybierania ekologicznych środków transportu — z grywalizacją (punkty, nagrody) i elementami edukacyjnymi. Zaprojektowana z Urzędem Miasta na podstawie badań jakościowych.",
    result: "Wyróżnienie w konkursie PFR. W grupie badawczej: +36% zainteresowania ekologią i −23% przejazdów samochodem.",
  },
  {
    id: "pgz",
    key: "pgz",
    overline: "Obronność / Deep Tech",
    title: "System wykrywania anomalii morskich",
    meta: "2023 · Lead Product Designer · PGZ Stocznia Wojenna, PFR",
    desc: "System oparty na sieciach neuronowych, projektowany pod ścisłe wymagania kontraktora z sektora obronnego. Wizualizację danych zaprojektowałem tak, żeby operator mógł błyskawicznie zinterpretować anomalię w warunkach krytycznych.",
    result: "Pełne wdrożenie operacyjne u kontraktora i kwalifikacja do programu IDA Bootcamp",
    note: "Materiały wizualne niedostępne publicznie",
  },
];
---

<Layout title="Prace | Kamil Wardak" description="Projekty z bankowości, bezpieczeństwa, transportu, medycyny, sektora obronnego i miasta — w tym case studies BLIK dla Biznesu i kont walutowych w ING, REID, VTDA i TabBox.">
  <div class="bg-[#0c0a09]">

    <!-- ═══ NAGŁÓWEK ═══════════════════════════════════════════════════════ -->
    <section class="px-6 pt-14 md:pt-24">
      <div class="max-w-4xl mx-auto">
        <p class="wk-overline" data-i18n="works.overline">Prace</p>
        <h1 class="wk-heading" data-i18n="works.heading">Projekty, w których błąd kosztuje.</h1>
        <p class="wk-lead" data-i18n="works.lead">
          Projekty z bankowości, bezpieczeństwa, transportu, medycyny, sektora obronnego i miasta. Najważniejsze opisałem szczegółowo jako case study.
        </p>
      </div>
    </section>

    <!-- ═══ INDEKS PROJEKTÓW ═══════════════════════════════════════════════ -->
    <section class="px-6 pt-14 md:pt-20" aria-labelledby="wk-index-heading">
      <div class="max-w-4xl mx-auto">
        <h2 class="wk-label" id="wk-index-heading" data-i18n="works.index.heading">Wszystkie projekty w skrócie</h2>
        <div class="wk-table-wrap">
          <table class="wk-table">
            <caption class="sr-only" data-i18n="works.index.caption">Zestawienie projektów: rok, projekt, branża, rola i kluczowy wynik</caption>
            <thead>
              <tr>
                <th scope="col" data-i18n="works.col.year">Rok</th>
                <th scope="col" data-i18n="works.col.project">Projekt</th>
                <th scope="col" data-i18n="works.col.sector">Branża</th>
                <th scope="col" data-i18n="works.col.role">Rola</th>
                <th scope="col" data-i18n="works.col.result">Wynik</th>
                <td aria-hidden="true"></td>
              </tr>
            </thead>
            <tbody>
              {rows.map((r, i) => (
                <tr class="wk-row">
                  <td class="wk-year">{r.year}</td>
                  <th scope="row" class="wk-project">
                    <a href={r.href} class="wk-project-link">
                      <span data-i18n={`works.row.${i}.name`}>{r.name}</span>
                      <span class="wk-project-tag" data-i18n={r.href.startsWith('#') ? 'works.index.more' : 'works.index.case'}>
                        {r.href.startsWith('#') ? 'Opis niżej' : 'Case study'}
                      </span>
                    </a>
                  </th>
                  <td class="wk-sector">
                    <span data-i18n={`works.row.${i}.sector`}>{r.sector}</span>
                    {r.platforms && <span class="wk-platforms" data-i18n={`works.row.${i}.platforms`}>{r.platforms}</span>}
                  </td>
                  <td class="wk-role">{r.role}</td>
                  <td class="wk-result" data-i18n={`works.row.${i}.result`}>{r.result}</td>
                  <td class="wk-go" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class={r.href.startsWith('#') ? 'wk-go--down' : ''}>
                      <path d="M5 12h14m-7-7 7 7-7 7"/>
                    </svg>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ═══ CASE STUDY ════════════════════════════════════════════════════ -->
    <section class="px-6 pt-24 md:pt-32 pb-14">
      <div class="max-w-4xl mx-auto">
        <p class="wk-overline" data-i18n="works.cases.overline">Case study</p>
        <h2 class="wk-h2" data-i18n="works.cases.heading">Opisane szczegółowo</h2>
      </div>
    </section>
    <PortfolioSection showHeader={false} showMeta={true} />

    <!-- ═══ POZOSTAŁE PROJEKTY ════════════════════════════════════════════ -->
    <section class="px-6 pt-32 md:pt-40" aria-labelledby="wk-other-heading">
      <div class="max-w-4xl mx-auto">
        <p class="wk-overline" data-i18n="works.other.overline">Więcej prac</p>
        <h2 class="wk-h2" id="wk-other-heading" data-i18n="works.other.heading">Pozostałe projekty</h2>

        <div class="wk-other-grid">
          {others.map((p) => (
            <article class="wk-other" id={p.id}>
              {p.image && (
                <div class="wk-other-visual">
                  <ProjectImage src={p.image} alt={p.imageAlt} sizes="(min-width: 944px) 440px, calc(100vw - 48px)" class="w-full h-full object-cover" />
                </div>
              )}
              <p class="wk-other-overline" data-i18n={`works.${p.key}.overline`}>{p.overline}</p>
              <h3 class="wk-other-title" data-i18n={`works.${p.key}.title`}>{p.title}</h3>
              <p class="wk-other-meta" data-i18n={`works.${p.key}.meta`}>{p.meta}</p>
              <p class="wk-other-desc" data-i18n={`works.${p.key}.desc`}>{p.desc}</p>
              <p class="wk-other-result" data-i18n={`works.${p.key}.result`}>{p.result}</p>
              {p.link && (
                <a href={p.link} target="_blank" rel="noopener noreferrer" class="wk-other-link">
                  <span data-i18n={`works.${p.key}.link`}>Zobacz case study na Behance</span>
                  <span class="sr-only" data-i18n="works.newtab">(otwiera się w nowej karcie)</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
                </a>
              )}
              {p.note && <p class="wk-other-note" data-i18n={`works.${p.key}.note`}>{p.note}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ CV ═══════════════════════════════════════════════════════════ -->
    <section class="px-6 pt-20 md:pt-24 pb-24 md:pb-32">
      <div class="max-w-4xl mx-auto">
        <div class="wk-cta">
          <p class="wk-cta-text" data-i18n="works.cta.heading">Chcesz zobaczyć całą ścieżkę zawodową?</p>
          <div class="wk-cta-actions">
            <Button text="Pobierz CV" i18nKey="hero.cta.cv" hrefI18nKey="hero.cta.cv.href" variant="secondary" href="/Kamil_Wardak_CV_2026.pdf" download={true}>
              <svg slot="icon-default" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              <span slot="icon-hover" class="file-size" data-i18n="hero.cta.cv.size">1.1 MB</span>
            </Button>
            <a href="/o-mnie" class="wk-cta-link">
              <span data-i18n="works.cta.about">Doświadczenie i kompetencje</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<style>
  /* ── Typografia ─────────────────────────────────────────────── */
  .wk-overline {
    margin: 0 0 1rem;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--brand-main);
  }

  /* Rozmiar jak tytuł na stronie głównej (.hero-title) */
  .wk-heading {
    margin: 0;
    font-size: 3.5rem;
    font-weight: 600;
    line-height: 1.15;
    color: #fff;
    text-wrap: balance;
  }

  .wk-lead {
    margin: 1.5rem 0 0;
    max-width: 40rem;
    font-size: 1.125rem;
    line-height: 1.7;
    color: #a8a29e;
  }

  .wk-label {
    margin: 0 0 1rem;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .wk-h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: #fff;
  }

  /* ── Indeks (tabela) ────────────────────────────────────────── */
  .wk-table-wrap { overflow-x: auto; }

  .wk-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .wk-table thead th {
    padding: 0 12px 12px 0;
    text-align: left;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .wk-table tbody td,
  .wk-table tbody th {
    padding: 16px 12px 16px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .wk-year { color: rgba(255, 255, 255, 0.55); font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .wk-sector { color: rgba(255, 255, 255, 0.7); }
  .wk-platforms { display: block; margin-top: 0.2rem; font-size: 0.75rem; color: rgba(255, 255, 255, 0.5); }
  .wk-role { color: rgba(255, 255, 255, 0.6); max-width: 15rem; }
  .wk-result { color: var(--brand-main); font-weight: 700; }

  .wk-project-link {
    display: inline-flex;
    flex-direction: column;
    gap: 3px;
    font-weight: 700;
    color: #fff;
    transition: color 0.3s ease;
  }

  /* Cały wiersz klikalny: link w nazwie projektu rozciągnięty na wiersz (jeden link na wiersz dla czytników ekranu) */
  .wk-row { position: relative; transition: background-color 0.2s ease; }
  .wk-table tbody .wk-year,
  .wk-table thead th:first-child { padding-left: 12px; }
  .wk-table thead td { border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
  .wk-project-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 8px;
  }
  .wk-row:hover { background: rgba(255, 255, 255, 0.04); }
  .wk-row:hover .wk-project-link { color: var(--brand-main); }
  .wk-project-link:focus-visible { outline: none; }
  .wk-project-link:focus-visible::after { outline: 2px solid var(--brand-main); outline-offset: -2px; }

  .wk-go { width: 32px; padding-right: 12px !important; color: rgba(255, 255, 255, 0.35); }
  .wk-go svg { display: block; transition: transform 0.2s ease, color 0.2s ease; }
  .wk-go .wk-go--down { transform: rotate(90deg); }
  .wk-row:hover .wk-go,
  .wk-row:focus-within .wk-go { color: var(--brand-main); }
  .wk-row:hover .wk-go svg:not(.wk-go--down) { transform: translateX(4px); }
  .wk-row:hover .wk-go .wk-go--down { transform: rotate(90deg) translateX(4px); }
  @media (prefers-reduced-motion: reduce) {
    .wk-row:hover .wk-go svg:not(.wk-go--down) { transform: none; }
    .wk-row:hover .wk-go .wk-go--down { transform: rotate(90deg); }
  }

  .wk-project-tag {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
  }

  /* Telefon: każdy wiersz jako blok — rok i branża, projekt, rola, wynik */
  @media (max-width: 640px) {
    .wk-table thead { display: none; }
    .wk-table, .wk-table tbody, .wk-table tr { display: block; width: 100%; }
    .wk-table tr {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 10px;
      row-gap: 4px;
      padding: 16px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }
    .wk-table tbody td,
    .wk-table tbody th { display: block; padding: 0; border: 0; }
    .wk-year { grid-column: 1; grid-row: 1; font-size: 0.8rem; }
    .wk-sector { grid-column: 2; grid-row: 1; font-size: 0.8rem; }
    .wk-project, .wk-role, .wk-result { grid-column: 1 / -1; }
    .wk-role { max-width: none; font-size: 0.8rem; }
    .wk-table tr { padding-left: 12px; padding-right: 44px; }
    .wk-table tbody .wk-year { padding-left: 0; }
    .wk-go { position: absolute; top: 50%; right: 12px; transform: translateY(-50%); width: auto; padding: 0 !important; }
  }

  /* ── Pozostałe projekty ─────────────────────────────────────── */
  .wk-other-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .wk-other {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: 6rem;
  }

  .wk-other:target { border-color: rgba(186, 245, 42, 0.5); }

  .wk-other-visual {
    aspect-ratio: 16 / 9;
    margin: -0.5rem -0.5rem 1.5rem;
    border-radius: 0.9rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .wk-other-overline {
    margin: 0 0 0.75rem;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--brand-main);
  }

  .wk-other-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    color: #fff;
  }

  .wk-other-meta {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.55);
  }

  .wk-other-desc {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: #a8a29e;
  }

  .wk-other-result {
    margin: 1.25rem 0 0;
    padding-left: 0.9rem;
    border-left: 2px solid rgba(186, 245, 42, 0.55);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.45;
    color: #fff;
  }

  .wk-other-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 1.25rem;
    width: fit-content;
    font-size: 0.875rem;
    font-weight: 600;
    color: #fff;
    transition: color 0.3s ease, gap 0.3s ease;
  }
  .wk-other-link:hover { color: var(--brand-main); gap: 10px; }

  .wk-other-note {
    margin: auto 0 0;
    padding-top: 1.25rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.45);
  }

  @media (max-width: 767px) {
    .wk-heading { font-size: 2.25rem; }
    .wk-other-grid { grid-template-columns: 1fr; }
  }

  /* ── CTA z CV ───────────────────────────────────────────────── */
  .wk-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: 1.75rem 2rem;
    border-radius: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(186, 245, 42, 0.03);
  }

  .wk-cta-text {
    margin: 0;
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: 700;
    color: #fff;
  }

  .wk-cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .wk-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    transition: color 0.3s ease, gap 0.3s ease;
  }

  .wk-cta-link:hover { color: var(--brand-main); gap: 10px; }
</style>
