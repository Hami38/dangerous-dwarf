---
import Layout from '../../layouts/Layout.astro';
import Reveal from '../../components/Reveal.astro';
import Footer from '../../components/Footer.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import CaseTldr from '../../components/CaseTldr.astro';

const project = {
  overline: "Bezpieczeństwo krytyczne / Deep Tech",
  title: "VTDA — Wirtualny Asystent Maszynisty",
  subtitle: "Architektura decyzji i logiki bezpieczeństwa w transporcie kolejowym. Redukcja ryzyka incydentów o 20% w 6-miesięcznym pilocie.",
  role: "Lead UX & UI Designer",
  client: "Infracert",
  year: "2022",
  scope: "Product Design · Safety-Critical UX · Human Factors",
  team: "4 osoby",
  platforms: "iOS · Android · tablet",
  duration: "21 miesięcy",
  learned: "Oczekiwania interesariuszy nie zawsze pokrywały się z potrzebami maszynistów. Nauczyłem się łączyć te dwa światy: rozwiązanie stawia w centrum użytkownika końcowego, a jednocześnie zachowuje kluczowe wymagania biznesu. Projekt nauczył mnie też bliskiej współpracy z zespołem deweloperskim i języka inżynierów — był moim wejściem w świat uczenia maszynowego i sieci neuronowych.",
  i18n: "vtda",
};

const challenges = [
  {
    number: "01",
    title: "Reagowanie zamiast przewidywania",
    description: 'Maszyniści pracowali w modelu reaktywnym — odpowiadali na alerty zamiast przewidywać zdarzenia. Istniejące systemy wymuszały rolę procesora danych. Przy prędkościach kolejowych to krytyczny błąd architektoniczny.',
  },
  {
    number: "02",
    title: "Za dużo danych na jednym ekranie",
    description: 'Pierwsze prototypy wzorowane na systemach lotniczych (tzw. szklany kokpit) pokazywały setki parametrów telemetrycznych na jednym ekranie i paraliżowały decyzje. Szukanie kluczowej informacji odciągało wzrok od torów. Trzeba było pokazać o 60% mniej elementów.',
  },
  {
    number: "03",
    title: "Fizyka środowiska kabiny",
    description: 'Standardowy tryb ciemny okazał się niebezpieczny: jasne elementy interfejsu odbijały się nocą w szybie lokomotywy i zasłaniały widok torów. Projekt musiał dosłownie zmierzyć się z fizyką kabiny.',
  },
];

const results = [
  { value: "−20%", label: "ryzyka incydentów u regularnych użytkowników systemu w pilocie" },
  { value: "−5%", label: "wypadkowości u wszystkich przewoźników w pilocie w ciągu 6 miesięcy" },
  { value: "−40%", label: "czasu skanowania ekranu w testach z maszynistami (eye tracking)" },
  { value: "120+", label: "ekranów w skalowalnej, modularnej architekturze krytycznej dla bezpieczeństwa" },
];

const nextProjects = [
  { id: "blik",   overline: "Finanse / Strategia UX",             title: "BLIK dla Biznesu w ING", description: "Adaptacja retailowych wzorców płatniczych do złożonego ekosystemu bankowości korporacyjnej.", href: "/projekty/blik-dla-biznesu", image: "/images/ing/KV_blik.webp" },
  { id: "reid",   overline: "Bezpieczeństwo / Computer Vision",   title: "System reidentyfikacji osób dla infrastruktury krytycznej", description: "Integracja zaawansowanego rzemiosła UX z systemami wizyjnymi AI. 20% ROI w 6 miesięcy.", href: "/projekty/reid",             image: "/images/reid/hero_reid.webp" },
  { id: "tabbox", overline: "HealthTech / Senior Care / IoT",       title: "TabBox — Ekosystem farmakoterapii", description: "Ekosystem łączący fizyczny dozownik leków z aplikacją mobilną.", href: "/projekty/tabbox",           image: "/images/tabbox/KV_tabbox.webp" },
];
---

<Layout title={`${project.title} | Kamil Wardak`} description={project.subtitle}>

  <!-- ─── PRELOADER BYPASS ───────────────────────────────────────────────── -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('preloaderFinished'));
      }, 100);
    });
  </script>

  <div class="bg-[#0c0a09] min-h-screen">

    <!-- ─── SPACER pod header ──────────────────────────────────────────────── -->
    <div class="h-20"></div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         HERO SECTION
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-hero relative px-6 pt-0 pb-0 md:pt-16 overflow-hidden">
      <div class="max-w-4xl mx-auto">

        <!-- Breadcrumb -->
        <div class="cs-breadcrumb mb-10 opacity-0" data-hero-fade style="--delay: 0s">
          <a href="/prace" class="cs-back-link group inline-flex items-center gap-2 text-white/50 text-sm font-medium transition-colors duration-300 hover:text-[#BAF52A]">
            <svg class="cs-back-arrow transition-transform duration-300 group-hover:-translate-x-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14m-7-7-7 7 7 7"/>
            </svg>
            <span data-i18n="cs.back">Wszystkie projekty</span>
          </a>
        </div>

        <!-- Overline label -->
        <div class="mb-5 opacity-0" data-hero-fade style="--delay: 0.05s">
          <Reveal trigger="onLoad" delay={0.15} color="#BAF52A">
            <p class="cs-overline text-[#BAF52A] text-xs tracking-[0.15em] font-bold" data-i18n={`${project.i18n}.overline`}>{project.overline}</p>
          </Reveal>
        </div>

        <!-- Main title -->
        <div class="mb-6">
          <Reveal trigger="onLoad" delay={0.3} duration={0.8} color="#ffffff">
            <h1 class="cs-hero-title text-white font-bold leading-[1.05] tracking-tight" data-i18n={`${project.i18n}.title`}>
              {project.title}
            </h1>
          </Reveal>
        </div>

        <!-- Subtitle -->
        <div class="max-w-2xl mb-12">
          <Reveal trigger="onLoad" delay={0.55} color="#a8a29e">
            <p class="cs-hero-subtitle text-stone-400 text-lg md:text-xl font-medium leading-relaxed" data-i18n={`${project.i18n}.subtitle`}>
              {project.subtitle}
            </p>
          </Reveal>
        </div>

        <!-- Meta strip -->
        <div class="cs-meta-strip opacity-0" data-hero-fade style="--delay: 0.7s">
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.role">Rola</span>
            <span class="cs-meta-value">{project.role}</span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.client">Klient</span>
            <span class="cs-meta-value">{project.client}</span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.when">Rok · czas</span>
            <span class="cs-meta-value">{project.year} · <span data-i18n={`${project.i18n}.duration`}>{project.duration}</span></span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.scope">Zakres</span>
            <span class="cs-meta-value" data-i18n={`${project.i18n}.scope`}>{project.scope}</span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.team">Zespół</span>
            <span class="cs-meta-value" data-i18n={`${project.i18n}.team`}>{project.team}</span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.platforms">Platformy</span>
            <span class="cs-meta-value" data-i18n={`${project.i18n}.platforms`}>{project.platforms}</span>
          </div>
        </div>


        <!-- TL;DR — problem, rola, wynik w trzech liniach -->
        <CaseTldr
          i18n={project.i18n}
          problem="Maszyniści reagowali na alerty zamiast przewidywać zdarzenia, a interfejsy wzorowane na lotnictwie odciągały wzrok od torów."
          role="Lead Product Designer / UX Architect: architektura decyzji i logiki bezpieczeństwa, human factors i projekt dopasowany do warunków w kabinie."
          result="−20% ryzyka incydentów w 6-miesięcznym pilocie u kilku przewoźników kolejowych i −5% wypadkowości u wszystkich przewoźników w pilocie."
        />
      </div>
    </section>

    <!-- ─── NOTA O POUFNOŚCI ─────────────────────────────────────────────── -->
    <section class="px-6 pt-8 pb-0">
      <div class="max-w-4xl mx-auto">
        <div class="cs-confidentiality-note opacity-0" data-hero-fade style="--delay: 0.85s">
          <svg class="cs-conf-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <p>
            <strong data-i18n={`${project.i18n}.conf.title`}>Nota o charakterze projektu:</strong> <span data-i18n={`${project.i18n}.conf`}>VTDA jest systemem krytycznym dla bezpieczeństwa. Prezentowane materiały wizualne pochodzą z fazy projektowej i zostały zanonimizowane. Niniejsze case study koncentruje się na architekturze decyzji UX, psychologii bezpieczeństwa i mierzalnym wpływie operacyjnym — nie na finalnych detalach produkcyjnych interfejsu.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- ─── HERO IMAGE ─────────────────────────────────────────────────────── -->
    <section class="cs-hero-image-section px-6 pt-12 pb-0">
      <div class="max-w-4xl mx-auto">
        <div class="cs-hero-img-wrapper opacity-0" data-scroll-fade>
          <div class="aspect-[16/7] rounded-3xl overflow-hidden border border-white/5">
            <ProjectImage src="/images/vtda/VTDA_01.webp" alt="VTDA — wirtualny asystent maszynisty, mockup tabletu w kabinie lokomotywy" class="w-full h-full object-cover cs-img" loading="eager" fetchpriority="high" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEKCJA 1 — KONTEKST
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-section px-6 pt-28 md:pt-36 pb-0">
      <div class="max-w-4xl mx-auto">

        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-start">

          <!-- Left: Number + heading -->
          <div class="md:col-span-5">
            <Reveal delay={0.1} color="#BAF52A">
              <p class="cs-section-number">01</p>
            </Reveal>
            <Reveal delay={0.25} color="#ffffff">
              <h2 class="cs-section-heading mt-3" data-i18n={`${project.i18n}.s1.heading`}>
                System jako proaktywny asystent, nie pasywny wyświetlacz
              </h2>
            </Reveal>
          </div>

          <!-- Right: Body text -->
          <div class="md:col-span-7">
            <Reveal delay={0.35} color="#a8a29e">
              <p class="cs-body-text mb-6" data-i18n={`${project.i18n}.s1.body1`}>
                W kabinie lokomotywy głównym wyzwaniem nie jest brak danych — jest ich nadmiar. Maszyniści pracowali reaktywnie: odpowiadali na alerty zamiast przewidywać zdarzenia. Przy prędkościach kolejowych reaktywność to krytyczny błąd bezpieczeństwa.
              </p>
            </Reveal>
            <Reveal delay={0.5} color="#a8a29e">
              <p class="cs-body-text" data-i18n={`${project.i18n}.s1.body2`}>
                Moją diagnozą UX było to, że istniejące systemy wymuszały na człowieku rolę „procesora danych”. Celem projektu było przesunięcie roli systemu z biernego wyświetlacza na proaktywnego asystenta, który zarządza uwagą maszynisty i filtruje szum informacyjny — szczególnie w sytuacjach wysokiego stresu.
              </p>
            </Reveal>
          </div>

        </div>

        <!-- Context images -->
        <div class="cs-img-wrapper mt-16 opacity-0" data-scroll-fade>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <figure class="m-0 p-0">
              <div class="aspect-[4/3] rounded-2xl overflow-hidden border border-white/5">
                <ProjectImage src="/images/vtda/VTDA_04.webp" alt="Sterownia maszynisty - agregacja bodźców użytkownika" class="w-full h-full object-cover cs-img" loading="lazy" />
              </div>
              <figcaption class="cs-img-caption" data-i18n="vtda.caption.0">Sterownia maszynisty - agregacja bodźców użytkownika</figcaption>
            </figure>
            <figure class="m-0 p-0">
              <div class="aspect-[4/3] rounded-2xl overflow-hidden border border-white/5">
                <ProjectImage src="/images/vtda/VTDA_13.webp" alt="Ewolucja Dashboardu — wersja finalna po redukcji o 60%" class="w-full h-full object-cover cs-img" loading="lazy" />
              </div>
              <figcaption class="cs-img-caption" data-i18n="vtda.caption.1">Ewolucja Dashboardu — wersja finalna po redukcji widoku</figcaption>
            </figure>
          </div>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEKCJA 2 — WYZWANIA
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-section cs-section--dark px-6 pt-28 md:pt-36 pb-28 md:pb-36">
      <div class="max-w-4xl mx-auto">

        <!-- Section header -->
        <div class="mb-16 md:mb-20">
          <Reveal delay={0.1} color="#BAF52A">
            <p class="cs-section-number">02</p>
          </Reveal>
          <Reveal delay={0.25} color="#ffffff">
            <h2 class="cs-section-heading mt-3 max-w-xl" data-i18n={`${project.i18n}.s2.heading`}>
              Projektowanie pod presją fizyki i&nbsp;psychologii
            </h2>
          </Reveal>
          <Reveal delay={0.4} color="#a8a29e">
            <p class="cs-body-text max-w-2xl mt-4" data-i18n={`${project.i18n}.s2.intro`}>
              Trzy wyzwania, z których każde wprost wpływało na bezpieczeństwo jazdy.
            </p>
          </Reveal>
        </div>

        <!-- Challenge cards -->
        <div class="cs-challenges-grid">
          {challenges.map((ch, i) => (
            <div class="cs-challenge-card opacity-0" data-scroll-fade style={`--fade-delay: ${0.1 + i * 0.15}s`}>
              <div class="cs-challenge-number">{ch.number}</div>
              <div class="cs-challenge-content">
                <h3 class="cs-challenge-title" data-i18n={`${project.i18n}.challenge.${i}.title`}>{ch.title}</h3>
                <p class="cs-challenge-desc" data-i18n={`${project.i18n}.challenge.${i}.desc`}>{ch.description}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Night mode image -->
        <div class="mt-20 opacity-0" data-scroll-fade style="--fade-delay: 0.3s">
          <figure class="m-0 p-0">
            <div class="aspect-[21/9] rounded-3xl overflow-hidden border border-white/5">
              <ProjectImage src="/images/vtda/VTDA_11.webp" alt="Interfejs w trybie nocnym — ekstremalnie niska luminancja eliminująca refleksy na szybie" class="w-full h-full object-cover cs-img" loading="lazy" />
            </div>
            <figcaption class="cs-img-caption" data-i18n="vtda.caption.2">Tryb nocny — ekstremalnie niska luminancja, barwy nieoddbijające się w szybie kabiny</figcaption>
          </figure>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEKCJA 3 — PODEJŚCIE PROJEKTOWE
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-section px-6 pt-28 md:pt-36 pb-0">
      <div class="max-w-4xl mx-auto">

        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-start">

          <!-- Left: Heading -->
          <div class="md:col-span-5 md:sticky md:top-28">
            <Reveal delay={0.1} color="#BAF52A">
              <p class="cs-section-number">03</p>
            </Reveal>
            <Reveal delay={0.25} color="#ffffff">
              <h2 class="cs-section-heading mt-3" data-i18n={`${project.i18n}.s3.heading`}>
                Architektura decyzji i&nbsp;logiki bezpieczeństwa
              </h2>
            </Reveal>
            <Reveal delay={0.4} color="#a8a29e">
              <p class="cs-body-text mt-4" data-i18n={`${project.i18n}.s3.intro`}>
                Każda decyzja projektowa miała uzasadnienie w psychologii bezpieczeństwa i fizyce środowiska. UX służył tu nie wygodzie, a utrzymaniu czujności i precyzji operatora.
              </p>
            </Reveal>
          </div>

          <!-- Right: Role items -->
          <div class="md:col-span-7 flex flex-col gap-10">

            <div class="cs-role-item opacity-0" data-scroll-fade style="--fade-delay: 0.1s">
              <div class="cs-role-tag" data-i18n={`${project.i18n}.role1.tag`}>Stopniowe ujawnianie informacji</div>
              <p class="cs-body-text mt-3" data-i18n={`${project.i18n}.role1.body`}>
                Na ekranie głównym zostało o 60% mniej elementów. Widok krytyczny pokazuje wyłącznie prędkość, następny cel i krzywą hamowania. Szczegóły techniczne — parametry radia, diagnostyka — pojawiają się tylko na żądanie albo gdy system wykryje anomalię wymagającą interwencji. Mniej danych, lepsze decyzje.
              </p>
              <div class="mt-6 opacity-0" data-scroll-fade style="--fade-delay: 0.2s">
                <figure class="m-0 p-0">
                  <div class="aspect-[16/7] rounded-2xl overflow-hidden border border-white/5">
                    <ProjectImage src="/images/vtda/VTDA_14.webp" alt="Dashboard po redukcji — widok krytyczny z Progressive Disclosure" class="w-full h-full object-cover cs-img" loading="lazy" />
                  </div>
                  <figcaption class="cs-img-caption" data-i18n="vtda.caption.3">Dashboard po redukcji — trzy elementy krytyczne, zero szumu</figcaption>
                </figure>
              </div>
            </div>

            <div class="cs-role-item opacity-0" data-scroll-fade style="--fade-delay: 0.2s">
              <div class="cs-role-tag" data-i18n={`${project.i18n}.role2.tag`}>Efekt checklisty: świadome potwierdzenie gotowości</div>
              <p class="cs-body-text mt-3" data-i18n={`${project.i18n}.role2.body`}>
                Mimo technicznej możliwości pełnej automatyzacji zdecydowałem, że kontrola systemu przed odjazdem („System Check”) zostaje manualna. Maszynista musi świadomie zatwierdzić gotowość składu. Efekt checklisty buduje poczucie odpowiedzialności i wymusza świadome przejście przez procedurę — UX służy tu czujności, nie komfortowi.
              </p>
              <div class="mt-6 opacity-0" data-scroll-fade style="--fade-delay: 0.25s">
                <figure class="m-0 p-0">
                  <div class="aspect-[16/7] rounded-2xl overflow-hidden border border-white/5">
                    <ProjectImage src="/images/vtda/VTDA_08.webp" alt="Ekran manualnej weryfikacji systemu — Checklist Effect" class="w-full h-full object-cover cs-img" loading="lazy" />
                  </div>
                  <figcaption class="cs-img-caption" data-i18n="vtda.caption.4">System Check — manualna weryfikacja jako celowy mechanizm budowania czujności</figcaption>
                </figure>
              </div>
            </div>

            <div class="cs-role-item opacity-0" data-scroll-fade style="--fade-delay: 0.3s">
              <div class="cs-role-tag" data-i18n={`${project.i18n}.role3.tag`}>Widok tunelowy trasy</div>
              <p class="cs-body-text mt-3" data-i18n={`${project.i18n}.role3.body`}>
                Zamiast klasycznej mapy 2D zaprojektowałem liniową reprezentację trasy (Guiding Rails). Pociąg jedzie tylko w jednym kierunku — maszynistę nie interesuje otoczenie geograficzne, tylko to, co jest na jego „nitce” toru. W testach z maszynistami z użyciem eye trackingu czas skanowania ekranu skrócił się o 40%.
              </p>
            </div>

          </div>
        </div>

        <!-- Full-width mockup -->
        <div class="mt-20 opacity-0" data-scroll-fade>
          <figure class="m-0 p-0">
            <div class="aspect-[16/8] rounded-3xl overflow-hidden border border-white/5">
              <ProjectImage src="/images/vtda/VTDA_09.webp" alt="VTDA — podsumowanie wyników systemu i statystyk pilotażu" class="w-full h-full object-cover cs-img" loading="lazy" />
            </div>
            <figcaption class="cs-img-caption" data-i18n="vtda.caption.5">VTDA w działaniu — podsumowanie kluczowych wyników 6-miesięcznego pilotażu</figcaption>
          </figure>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEKCJA 4 — EFEKTY I WPŁYW BIZNESOWY
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-section cs-section--results px-6 pt-28 md:pt-36 pb-28 md:pb-36">
      <div class="max-w-4xl mx-auto">

        <!-- Header -->
        <div class="mb-16 md:mb-20">
          <Reveal delay={0.1} color="#BAF52A">
            <p class="cs-section-number">04</p>
          </Reveal>
          <Reveal delay={0.25} color="#ffffff">
            <h2 class="cs-section-heading mt-3" data-i18n={`${project.i18n}.s4.heading`}>
              Wyniki mierzone bezpieczeństwem
            </h2>
          </Reveal>
          <Reveal delay={0.4} color="#a8a29e">
            <p class="cs-body-text max-w-2xl mt-4" data-i18n={`${project.i18n}.s4.intro`}>
