---
import '../styles/global.css';
import Header from '../components/Header.astro';
import PageTransition from '../components/PageTransition.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = "Kamil Wardak | Portfolio",
	description = "Kamil Wardak — Design Strategist & Lead UX Designer. 12 lat projektowania złożonych systemów dla sektora finansowego, medycznego i zbrojeniowego. Obecnie ING Bank Śląski.",
	image = "/og-image.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Open Graph / LinkedIn / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Kamil Wardak" />
		<meta property="og:locale" content="pl_PL" />
		<meta property="og:locale:alternate" content="en_GB" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Kamil Wardak — Design Strategist & Lead UX Designer" />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />
		<!-- Ustawia stan przejścia i język PRZED pierwszym renderem — zero flashu -->
		<script is:inline>
			// .js — JS działa (bez niej CSS pokazuje treść bez animacji)
			// .reduce-motion — użytkownik ma w systemie ograniczenie ruchu
			document.documentElement.classList.add('js');
			var _reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (_reduce) document.documentElement.classList.add('reduce-motion');

			if (sessionStorage.getItem('ct')) {
				document.documentElement.classList.add('curtain-ready');
			}
			// Preloader tylko przy pierwszym wejściu w sesji
			if (sessionStorage.getItem('np') || sessionStorage.getItem('preloaderSeen') || _reduce) {
				document.documentElement.classList.add('no-preloader');
			}
			var _lang = localStorage.getItem('lang') || 'pl';
			document.documentElement.lang = _lang;
			document.documentElement.setAttribute('data-lang', _lang);
		</script>
	</head>
	<body>
		<PageTransition />
		<Header />
		<main>
			<slot />
		</main>
		<SpeedInsights />
		<Analytics />

		<script>
			import { initBlockReveals } from '../utils/blockReveal';
			import { initI18n, applyTranslations, getLang } from '../i18n/client';

			// Inicjalizacja tłumaczeń przy każdym załadowaniu strony
			initI18n();

			const run = () => {
				if (document.body.dataset.revealsInit) return;
				document.body.dataset.revealsInit = 'true';
				initBlockReveals();
			};

			// Ponowne zastosowanie tłumaczeń po animacjach przejścia
			window.addEventListener('preloaderFinished', () => {
				applyTranslations(getLang());
				run();
			}, { once: true });

			window.addEventListener('curtainDone', () => {
				applyTranslations(getLang());
				run();
			}, { once: true });

			document.addEventListener('DOMContentLoaded', () => {
				if (!document.getElementById('preloader')) {
					setTimeout(() => run(), 150);
				}
			});
		</script>
	</body>
</html>

<style is:global>
	.action-reveal {
		opacity: 0;
		transform: translateY(20px);
	}

	/* Ukryj preloader przed pierwszym renderem gdy przyszliśmy z nawigacji */
	html.no-preloader #preloader {
		display: none !important;
	}

	/* Zasłona aktywna od razu — zanim JS zdąży się uruchomić */
	html.curtain-ready #curtain {
		transform: translateY(0%) !important;
	}
</style>
