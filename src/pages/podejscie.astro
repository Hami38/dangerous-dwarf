---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Reveal from '../components/Reveal.astro';

const pillar1Items = [
  {
    heading: "Struktura ponad estetyką",
    body: "Tam, gdzie regulacje (KNF, EBA, RODO), ograniczenia technologiczne i starsze systemy komplikują proces, porządkuję go. Projektuję architekturę informacji, która ogranicza ryzyko błędów i pozwala skupić się na decyzji, a nie na walce z interfejsem.",
    example: { id: "blik", href: "/projekty/blik-dla-biznesu", title: "BLIK dla Biznesu w ING" }
  },
  {
    heading: "Prostota, która ogranicza ryzyko",
    body: "W bankowości i systemach bezpieczeństwa prostota to nie minimalizm wizualny, tylko mniejsze obciążenie poznawcze. Projektuję interakcje przewidywalne i zgodne z wymaganiami compliance.",
    example: { id: "vtda", href: "/projekty/vtda", title: "VTDA — Wirtualny Asystent Maszynisty" }
  },
  {
    heading: "Dane i badania razem",
    body: "Dane pokazują, co się dzieje, a badania jakościowe — dlaczego. Analityka weryfikuje hipotezy, a zrozumienie szerszego kontekstu pozwala projektować z wyprzedzeniem.",
    example: { id: "reid", href: "/projekty/reid", title: "System reidentyfikacji osób dla infrastruktury krytycznej" }
  }
];

const pillar2Items = [
  {
    heading: "Kultura oparta na dowodach",
    body: "Zamieniam „wydaje mi się” na „sprawdziliśmy”. Decyzje opieram na badaniach i danych, dzięki czemu design staje się przewidywalną częścią procesu biznesowego, a nie kwestią gustu.",
    example: { id: "blik", href: "/projekty/blik-dla-biznesu", title: "BLIK dla Biznesu w ING" }
  },
  {
    heading: "Facylitacja i współpraca",
    body: "Łączę IT, biznes i compliance. Prowadzę warsztaty i proces decyzyjny tak, żeby każda funkcja miała jasny cel biznesowy i nie traciła na jakości UX.",
    example: { id: "vtda", href: "/projekty/vtda", title: "VTDA — Wirtualny Asystent Maszynisty" }
  },
  {
    heading: "Mentoring i samodzielność zespołu",
    body: "Rozwijam samodzielność projektantów: uczę myślenia strategicznego i bronienia decyzji argumentami, a nie gustem. Prowadziłem zespoły projektowe w REID i TabBox.",
    example: { id: "tabbox", href: "/projekty/tabbox", title: "TabBox — Ekosystem farmakoterapii" }
  }
];

const whyMe = [
  {
    number: "01",
    heading: "Gdy produkt działa w regulowanym środowisku",
    body: "Regulacje traktuję jak parametry projektowe. W BLIK dla Biznesu ograniczenia systemu stały się podstawą prostego procesu dla firm."
  },
  {
    number: "02",
    heading: "Gdy liczy się mierzalny wynik",
    body: "20% ROI w pół roku w REID, −20% ryzyka incydentów w VTDA, ponad 1 mln zł transakcji w pierwszym tygodniu BLIK dla Biznesu."
  },
  {
    number: "03",
    heading: "Gdy trzeba pogodzić jakość z tempem",
    body: "Wiem, kiedy dopracować detal, a kiedy szybciej dostarczyć wartość. REID: od startu do wdrożenia u klienta w 60 dni."
  }
];
---

<Layout title="Podejście | Kamil Wardak" description="Jak pracuję: od strategii i badań, przez architekturę decyzji, po mierzalny wpływ biznesowy. Podejście Kamila Wardaka do projektowania złożonych systemów.">

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('preloaderFinished'));
      }, 100);
    });
  </script>

  <div class="bg-[#0c0a09] min-h-screen">

    <!-- ═══════════════════════════════════════════════════════════════════════
         HERO
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="relative px-6 pt-16 md:pt-28 pb-20 md:pb-32 overflow-hidden">

      <div class="pd-hero-glow" aria-hidden="true"></div>
      <div class="pd-hero-grid" aria-hidden="true"></div>

      <div class="max-w-4xl mx-auto relative z-10">

        <div class="mb-5 opacity-0" data-hero-fade style="--delay: 0s">
          <Reveal delay={0} color="#BAF52A">
            <p class="pd-overline" data-i18n="approach.overline">Podejście</p>
          </Reveal>
        </div>

        <h1 class="pd-headline opacity-0" data-hero-fade style="--delay: 0.07s">
          <span data-i18n-html="approach.headline">Strategia to rzemiosło<br/><span class="pd-headline-accent">wprowadzania struktury w&nbsp;chaos.</span></span>
        </h1>

        <p class="pd-lead max-w-2xl mt-6 opacity-0" data-hero-fade style="--delay: 0.14s" data-i18n="approach.lead">
          Moje podejście opiera się na dwóch filarach: precyzyjnej analizie skomplikowanych
          ekosystemów oraz budowaniu kultury projektowej, w której design jest mierzalnym
          partnerem biznesu. Nie szukam najprostszych rozwiązań — szukam tych najskuteczniejszych.
        </p>

        <!-- Pillar navigation anchors -->
        <div class="flex flex-col md:flex-row md:flex-wrap md:items-center gap-4 mt-10 opacity-0" data-hero-fade style="--delay: 0.21s">
          <a href="#fragmentacja-big-picture" class="pd-anchor-btn pd-anchor-btn--primary">
            <span data-i18n="approach.pillar1.anchor">01 · Porządkowanie złożoności</span>
            <svg class="pd-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14m-7-7 7 7 7-7"/>
            </svg>
          </a>
          <a href="#zarzadzanie-przywodztwo" class="pd-anchor-btn pd-anchor-btn--secondary">
            <span data-i18n="approach.pillar2.anchor">02 · Przywództwo i współpraca</span>
            <svg class="pd-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14m-7-7 7 7 7-7"/>
            </svg>
          </a>
        </div>

        <!-- Divider with glow -->
        <div class="pd-hero-divider mt-16 md:mt-20 opacity-0" data-hero-fade style="--delay: 0.28s" aria-hidden="true"></div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FILAR I — Porządkowanie złożoności
    ════════════════════════════════════════════════════════════════════════ -->
    <section
      id="fragmentacja-big-picture"
      class="pd-pillar-section pd-pillar--cool relative px-6 py-24 md:py-32 overflow-hidden"
    >
      <span class="pd-bg-num" aria-hidden="true">01</span>
      <div class="pd-pillar-glow pd-pillar-glow--a" aria-hidden="true"></div>

      <div class="max-w-4xl mx-auto relative z-10">

        <!-- Section header -->
        <div class="mb-14 md:mb-20">

          <div class="opacity-0 mb-5" data-scroll-fade>
            <span class="pd-pill" data-i18n="approach.pillar1.pill">Filar I</span>
          </div>

          <div class="opacity-0" data-scroll-fade style="--fade-delay: 0.08s">
            <p class="pd-pillar-tag" data-i18n="approach.pillar1.tag">Porządkowanie złożoności</p>
          </div>

          <h2 class="pd-pillar-heading opacity-0" data-scroll-fade style="--fade-delay: 0.16s">
            <span data-i18n-html="approach.pillar1.heading">Projektowanie logiki<br class="hidden md:block"/>w środowiskach wysokiej złożoności.</span>
          </h2>

          <p class="pd-pillar-intro opacity-0" data-scroll-fade style="--fade-delay: 0.24s" data-i18n="approach.pillar1.intro">
            W sektorze finansowym i systemach krytycznych złożoność nie jest przeszkodą —
            jest naturalnym środowiskiem pracy. Moim zadaniem jest dekonstrukcja tej złożoności
            i zamiana jej w intuicyjne, bezpieczne procesy.
          </p>

        </div>

        <!-- Items grid -->
        <div class="pd-items-grid">
          {pillar1Items.map((item, i) => (
            <div
              class="pd-item opacity-0"
              data-scroll-fade
              style={`--fade-delay: ${0.08 + i * 0.1}s`}
            >
              <p class="pd-item-num">{String(i + 1).padStart(2, '0')}</p>
              <div class="pd-item-line" aria-hidden="true"></div>
              <h3 class="pd-item-heading" data-i18n={`approach.pillar1.item.${i}.heading`}>{item.heading}</h3>
              <p class="pd-item-body" data-i18n={`approach.pillar1.item.${i}.body`}>{item.body}</p>
              <a href={item.example.href} class="pd-item-example">
                <span class="pd-item-example-label"><span data-i18n="approach.example">Przykład</span>:</span>
                <span data-i18n={`nextproject.${item.example.id}.title`}>{item.example.title}</span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
              </a>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FILAR II — Przywództwo i współpraca
    ════════════════════════════════════════════════════════════════════════ -->
    <section
      id="zarzadzanie-przywodztwo"
      class="pd-pillar-section pd-pillar--warm relative px-6 py-24 md:py-32 overflow-hidden"
    >
      <span class="pd-bg-num pd-bg-num--right" aria-hidden="true">02</span>
      <div class="pd-pillar-glow pd-pillar-glow--b" aria-hidden="true"></div>

      <div class="max-w-4xl mx-auto relative z-10">

        <!-- Section header -->
        <div class="mb-14 md:mb-20">

          <div class="opacity-0 mb-5" data-scroll-fade>
            <span class="pd-pill pd-pill--alt" data-i18n="approach.pillar2.pill">Filar II</span>
          </div>

          <div class="opacity-0" data-scroll-fade style="--fade-delay: 0.08s">
            <p class="pd-pillar-tag" data-i18n="approach.pillar2.tag">Przywództwo i współpraca</p>
          </div>

          <h2 class="pd-pillar-heading opacity-0" data-scroll-fade style="--fade-delay: 0.16s">
            <span data-i18n-html="approach.pillar2.heading">Design to sport zespołowy.<br/>Moja rola: pomóc zespołowi podejmować dobre decyzje.</span>
          </h2>

          <p class="pd-pillar-intro opacity-0" data-scroll-fade style="--fade-delay: 0.24s" data-i18n="approach.pillar2.intro">
            Lider UX w dużej organizacji to nie tylko strażnik jakości projektowej —
            to przede wszystkim łącznik między biznesem, technologią a użytkownikiem.
            Most, który sprawia, że decyzje mają sens dla wszystkich stron.
          </p>

        </div>

        <!-- Items grid -->
        <div class="pd-items-grid">
          {pillar2Items.map((item, i) => (
            <div
              class="pd-item pd-item--alt opacity-0"
              data-scroll-fade
              style={`--fade-delay: ${0.08 + i * 0.1}s`}
            >
              <p class="pd-item-num pd-item-num--alt">{String(i + 1).padStart(2, '0')}</p>
              <div class="pd-item-line pd-item-line--alt" aria-hidden="true"></div>
              <h3 class="pd-item-heading" data-i18n={`approach.pillar2.item.${i}.heading`}>{item.heading}</h3>
              <p class="pd-item-body" data-i18n={`approach.pillar2.item.${i}.body`}>{item.body}</p>
              <a href={item.example.href} class="pd-item-example">
                <span class="pd-item-example-label"><span data-i18n="approach.example">Przykład</span>:</span>
                <span data-i18n={`nextproject.${item.example.id}.title`}>{item.example.title}</span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
              </a>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         WHY ME
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="relative px-6 py-24 md:py-32 overflow-hidden">

      <div class="max-w-4xl mx-auto">

        <div class="mb-16 md:mb-20 opacity-0" data-scroll-fade>
          <p class="text-[#BAF52A] text-xs tracking-[0.15em] font-bold mb-5 uppercase" data-i18n="approach.why.overline">
            Współpraca
          </p>
          <h2 class="pd-section-heading" data-i18n-html="approach.why.heading">
            Kiedy warto zaprosić mnie do projektu?
          </h2>
        </div>

        <div class="pd-why-grid">
          {whyMe.map((item, i) => (
            <div
              class="pd-why-card opacity-0"
              data-scroll-fade
              style={`--fade-delay: ${0.06 + i * 0.1}s`}
            >
              <p class="pd-why-num">{item.number}</p>
              <h3 class="pd-why-heading" data-i18n={`approach.why.${i}.heading`}>{item.heading}</h3>
              <p class="pd-why-body" data-i18n={`approach.why.${i}.body`}>{item.body}</p>
            </div>
          ))}
        </div>

        <!-- Dowody zamiast cytatu — link do case study -->
        <div class="pd-practice opacity-0 mt-16 md:mt-20" data-scroll-fade style="--fade-delay: 0.3s">
          <p class="pd-practice-label" data-i18n="approach.practice.label">Zobacz to w praktyce</p>
          <a href="/prace" class="pd-practice-link">
            <span data-i18n="approach.practice.link">Wszystkie projekty</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
          </a>
        </div>

      </div>
    </section>

    <Footer />
  </div>

</Layout>

<style is:global>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }

  /* ─── Przykład z case study pod zasadą ─── */
  /* Zwykły tekst w linii — strzałka trzyma się ostatniego słowa tytułu */
  .pd-item-example {
    display: block;
    margin-top: 14px;
    line-height: 1.5;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255,255,255,0.75);
    transition: color 0.3s ease;
  }
  .pd-item-example:hover { color: #BAF52A; }
  .pd-item-example-label { color: rgba(255,255,255,0.5); margin-right: 4px; }
  .pd-item-example svg { display: inline-block; vertical-align: -2px; margin-left: 6px; }

  /* ─── „Zobacz to w praktyce” zamiast cytatu ─── */
  .pd-practice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding: 28px 32px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px;
    background: rgba(186,245,42,0.03);
  }
  .pd-practice-label {
    margin: 0;
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 700;
    color: #fff;
  }
  .pd-practice-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 24px;
    border-radius: 9999px;
    background: #BAF52A;
    color: #000;
    font-size: 15px;
    font-weight: 700;
    transition: background-color 0.35s ease, color 0.35s ease, box-shadow 0.35s ease;
  }
  .pd-practice-link:hover {
    background: #000;
    color: #BAF52A;
    box-shadow: 0 0 0 1px #BAF52A;
  }
</style>

<style>

  /* ─── Hero background elements ───────────────────────────────────────────── */

  .pd-hero-glow {
    position: absolute;
    top: -100px;
    right: -180px;
    width: 650px;
    height: 650px;
    background: radial-gradient(ellipse at center, rgba(186,245,42,0.065) 0%, transparent 65%);
    pointer-events: none;
  }

  .pd-hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(186,245,42,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(186,245,42,0.03) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 0%, black 40%, transparent 100%);
    pointer-events: none;
  }

  /* ─── Overline ───────────────────────────────────────────────────────────── */

  .pd-overline {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #BAF52A;
    margin: 0;
  }

  /* ─── Hero headline ──────────────────────────────────────────────────────── */

  /* Rozmiar i grubość jak tytuł na stronie głównej (.hero-title w Hero.astro) */
  .pd-headline {
    font-size: 3.5rem;
    font-weight: 600;
    line-height: 1.15;
    text-wrap: balance;
    color: #ffffff;
    margin: 0;
  }

  @media (max-width: 768px) {
    .pd-headline { font-size: 2.25rem; }
  }

  /* :global — span wstawiany przez tłumaczenia (innerHTML, bez atrybutu scope) */
  .pd-headline :global(.pd-headline-accent) {
    background: linear-gradient(135deg, #BAF52A 0%, #e8ff8a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ─── Lead text ──────────────────────────────────────────────────────────── */

  .pd-lead {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    line-height: 1.8;
    color: rgba(255,255,255,0.5);
    /* Odstęp od nagłówka tutaj — „margin: 0” nadpisywało klasę mt-6 z Tailwinda */
    margin: 1.5rem 0 0;
  }

  /* ─── Anchor navigation buttons ─────────────────────────────────────────── */

  .pd-anchor-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 26px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
    text-decoration: none;
    white-space: nowrap;
    width: 100%;
  }

  @media (min-width: 768px) {
    .pd-anchor-btn {
      width: auto;
    }
  }

  .pd-btn-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .pd-anchor-btn:hover .pd-btn-icon {
    transform: translateY(3px);
  }

  .pd-anchor-btn--primary {
    background-color: #BAF52A;
    color: #000000;
  }

  .pd-anchor-btn--primary:hover {
    background-color: #000;
    color: #BAF52A;
    box-shadow: 0 0 0 1px #BAF52A, 0 0 28px rgba(186,245,42,0.18);
  }

  .pd-anchor-btn--secondary {
    background-color: transparent;
    color: rgba(255,255,255,0.65);
    border: 1px solid rgba(255,255,255,0.15);
  }

  .pd-anchor-btn--secondary:hover {
    color: #BAF52A;
    border-color: rgba(186,245,42,0.4);
    background-color: rgba(186,245,42,0.04);
  }

  /* ─── Hero divider ───────────────────────────────────────────────────────── */

  .pd-hero-divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(186,245,42,0.2), rgba(255,255,255,0.06), transparent);
  }

  /* ─── Pillar sections ────────────────────────────────────────────────────── */

  .pd-pillar-section {
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .pd-pillar--cool {
    background: #0c0a09;
  }

  .pd-pillar--warm {
    background: #0f0d0b;
  }

  /* ─── Background large number ────────────────────────────────────────────── */

  .pd-bg-num {
    position: absolute;
    top: -3rem;
    left: -1rem;
    font-size: clamp(10rem, 22vw, 18rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.06em;
    color: var(--brand-main);
    opacity: 0.04;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .pd-bg-num--right {
    left: auto;
    right: -2rem;
  }

  /* ─── Pillar glows ───────────────────────────────────────────────────────── */

  .pd-pillar-glow {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
  }

  .pd-pillar-glow--a {
    top: -80px;
    right: -120px;
    width: 560px;
    height: 560px;
    background: radial-gradient(ellipse, rgba(186,245,42,0.05) 0%, transparent 65%);
  }

  .pd-pillar-glow--b {
    bottom: -80px;
    left: -120px;
    width: 560px;
    height: 560px;
    background: radial-gradient(ellipse, rgba(186,245,42,0.045) 0%, transparent 65%);
  }

  /* ─── Pill badges ────────────────────────────────────────────────────────── */

  .pd-pill {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #BAF52A;
    background: rgba(186,245,42,0.1);
    border: 1px solid rgba(186,245,42,0.28);
    border-radius: 9999px;
    padding: 4px 14px;
  }

  .pd-pill--alt {
    color: #a8e6ff;
    background: rgba(168,230,255,0.08);
    border-color: rgba(168,230,255,0.2);
  }

  /* ─── Pillar tag ─────────────────────────────────────────────────────────── */

  .pd-pillar-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: rgba(255,255,255,0.5);
    margin: 0 0 14px;
  }

  /* ─── Pillar heading ─────────────────────────────────────────────────────── */

  .pd-pillar-heading {
    font-size: clamp(1.75rem, 4.5vw, 2.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
