---
/* src/components/PortfolioSection.astro */
import Reveal from './Reveal.astro';
import ProjectImage from './ProjectImage.astro';

interface Props {
  /** Nagłówek sekcji „Od strategii po realny wpływ” — na /prace strona ma własny H1 */
  showHeader?: boolean;
  /** Wiersz z rokiem, czasem trwania i zespołem (na /prace) */
  showMeta?: boolean;
}

const { showHeader = true, showMeta = false } = Astro.props;

const cases = [
  {
    id: 1,
    key: "blik",
    duration: "8 miesięcy",
    team: "20 osób (zespół produktowy)",
    year: "2025–2026",
    overline: "Finanse / Strategia",
    headline: "BLIK dla Biznesu w ING",
    subtext: "Pierwszy na rynku BLIK korporacyjny. Workflow procesu i strategia UX dla kluczowego produktu bankowości biznesowej.",
    result: { value: "1 mln zł+", label: "wartości transakcji w pierwszym tygodniu" },
    metric: "UX Expert – Interaction Design",
    image: "/images/ing/KV_blik.webp",
    imageAlt: "BLIK dla Biznesu w ING — kluczowy visual projektu",
    reverse: false,
    href: "/projekty/blik-dla-biznesu",
  },
  {
    id: 5,
    key: "fx",
    duration: "2 miesiące",
    team: "15 osób (jedyny projektant)",
    year: "2026",
    overline: "Finanse / Product Design",
    headline: "Konta walutowe dla firm w ING",
    subtext: "Jeden wniosek: konto w nowej walucie, karta i kantor. Ścieżka przeprojektowana wokół celu klienta — zapłaty zagranicznemu kontrahentowi.",
    result: { value: "3 → 1", label: "osobne procesy zastąpione jednym wnioskiem" },
    metric: "UX Expert – Interaction Design",
    image: "/images/ing/KV_fx.webp",
    imageAlt: "Konta walutowe dla firm — wniosek w aplikacji: nowe konto USD, karta i dostęp do kantoru w jednej ścieżce",
    reverse: true,
    href: "/projekty/konta-walutowe",
  },
  {
    id: 2,
    key: "reid",
    duration: "12 miesięcy",
    team: "4 osoby",
    year: "2023",
    overline: "Bezpieczeństwo / Computer Vision",
    headline: "System reidentyfikacji osób dla infrastruktury krytycznej",
    subtext: "Skalowanie technologii analizy chodu i cech ogólnych. Integracja zaawansowanego rzemiosła UX z systemami wizyjnymi AI.",
    result: { value: "20% ROI", label: "w pierwszym półroczu po wdrożeniu" },
    metric: "Lead UX & UI Designer",
    image: "/images/reid/hero_reid.webp",
    imageAlt: "REID — dashboard operatora z podglądem kamer i detekcją osób na laptopie oraz aplikacja mobilna",
    reverse: false,
    href: "/projekty/reid",
  },
  {
    id: 3,
    key: "vtda",
    duration: "21 miesięcy",
    team: "4 osoby",
    year: "2022",
    overline: "Bezpieczeństwo krytyczne / Deep Tech",
    headline: "VTDA — Wirtualny Asystent Maszynisty",
    subtext: "Budowa systemu wspomagania decyzji w czasie rzeczywistym i minimalizacja obciążenia poznawczego.",
    result: { value: "−20%", label: "ryzyka incydentów w 6-miesięcznym pilocie" },
    metric: "Lead UX & UI Designer",
    image: "/images/vtda/VTDA_01.webp",
    imageAlt: "VTDA — wirtualny asystent maszynisty, mockup tabletu w kabinie lokomotywy",
    reverse: true,
    href: "/projekty/vtda",
  },
  {
    id: 4,
    key: "tabbox",
    duration: "7 miesięcy",
    team: "3 osoby",
    year: "2023",
    overline: "HealthTech / Senior Care / IoT",
    headline: "TabBox — Ekosystem farmakoterapii",
    subtext: "Zintegrowany system HW/SW łączący fizyczny dozownik leków z aplikacją mobilną. Kontrakt na masową produkcję w 8 tygodniach.",
    result: { value: "89%", label: "badanych użytkowników odnotowało poprawę regularności przyjmowania leków" },
    metric: "Lead Product Designer",
    image: "/images/tabbox/KV_tabbox.webp",
    imageAlt: "TabBox — inteligentny system farmakoterapii dla seniorów",
    reverse: false,
    href: "/projekty/tabbox",
  },
];
---

<section class={`portfolio-section relative bg-[#0c0a09] ${showHeader ? "pt-24" : "pt-0"} pb-0 px-6 overflow-hidden`}>
  <div class="max-w-4xl w-full mx-auto">
    
    <!-- Section Header -->
    {showHeader && (
    <div class="mb-20 md:mb-28 max-w-4xl">
      <Reveal delay={0.1}>
        <p class="section-overline text-[#BAF52A] text-xs Normalcase tracking-[0.15em] font-bold mb-4" data-i18n="portfolio.overline">Wybrane projekty</p>
      </Reveal>
      <Reveal delay={0.25}>
        <h2 class="section-heading text-white text-4xl md:text-5xl font-bold leading-tight" data-i18n-html="portfolio.heading">
          Od strategii <br class="hidden md:block" />po realny wpływ.
        </h2>
      </Reveal>
    </div>
    )}

    <!-- Case Cards -->
    <div class="cases-grid flex flex-col gap-32 md:gap-40">
      {cases.map((caseItem, index) => (
        <article 
          class={`case-card-wrapper ${caseItem.reverse ? 'reverse' : ''}`}
          data-case-index={index}
        >
          <div class="case-card max-w-[1024px] mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
            
            <!-- Visual (60%) -->
            <div class={`case-visual md:col-span-7 ${caseItem.reverse ? 'md:order-2' : ''}`}>
              <a href={caseItem.href} class="visual-link block">
                <div class="visual-frame relative aspect-[16/10] bg-stone-900/50 rounded-3xl overflow-hidden border border-white/5">
                  <ProjectImage
                    src={caseItem.image}
                    alt={caseItem.imageAlt}
                    sizes="(min-width: 944px) 520px, (min-width: 768px) 56vw, calc(100vw - 48px)"
                    class="w-full h-full object-cover opacity-0"
                    data-reveal-image
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
                </div>
              </a>
            </div>

            <!-- Content (40%) -->
            <div class={`case-content md:col-span-5 ${caseItem.reverse ? 'md:order-1' : ''}`}>
              <div class="mb-3">
                <Reveal delay={0.2 + index * 0.1} color="#BAF52A" tag="span">
                  <p class="case-overline text-[#BAF52A] text-[12px] normalcase tracking-[0.15em] font-bold" data-i18n={`portfolio.case.${index}.overline`}>
                    {caseItem.overline}
                  </p>
                </Reveal>
              </div>

              <div class="mb-4">
                <Reveal delay={0.35 + index * 0.1} color="#ffffff" tag="span">
                  <h3 class="case-headline text-white text-2xl md:text-3xl font-bold leading-tight" data-i18n={`portfolio.case.${index}.headline`}>
                    {caseItem.headline}
                  </h3>
                </Reveal>
              </div>

              {showMeta && (
                <p class="case-meta">
                  <span>{caseItem.year}</span>
                  <span class="case-meta-dot" aria-hidden="true">·</span>
                  <span data-i18n={`${caseItem.key}.duration`}>{caseItem.duration}</span>
                  <span class="case-meta-dot" aria-hidden="true">·</span>
                  <span data-i18n={`${caseItem.key}.team`}>{caseItem.team}</span>
                </p>
              )}

              <!-- Kluczowy wynik — najważniejsza liczba projektu -->
              <div class="case-result mb-5 opacity-0" data-fade-in style={`transition-delay: ${0.45 + index * 0.1}s`}>
                <span class="case-result-value" data-i18n={`portfolio.case.${index}.result.value`}>{caseItem.result.value}</span>
                <span class="case-result-label" data-i18n={`portfolio.case.${index}.result.label`}>{caseItem.result.label}</span>
              </div>

              <div class="mb-6">
                <Reveal delay={0.5 + index * 0.1} color="#a8a29e" tag="span">
                  <p class="case-subtext text-stone-400 text-sm md:text-base font-medium leading-relaxed" data-i18n={`portfolio.case.${index}.subtext`}>
                    {caseItem.subtext}
                  </p>
                </Reveal>
              </div>

              <div class="flex flex-col gap-4">
                <div class="case-metric inline-flex items-center px-4 py-2 bg-white/5 backdrop-blur-sm rounded-full border border-white/10 opacity-0 w-fit" data-fade-in style={`transition-delay: ${0.65 + index * 0.1}s`}>
                  <span class="text-xs font-bold text-white/80 leading-none" data-i18n={`portfolio.case.${index}.metric`}>{caseItem.metric}</span>
                </div>

                <a href={caseItem.href} class="case-cta group inline-flex items-center gap-2 text-sm font-semibold text-white transition-all duration-300 opacity-0 w-fit" data-fade-in style={`transition-delay: ${0.8 + index * 0.1}s`}>
                  <span data-i18n="portfolio.cta">Zobacz case study</span>
                  <!-- Cel linku dla czytników ekranu (4× „Zobacz case study” jest niejednoznaczne) -->
                  <span class="sr-only"> — <span data-i18n={`portfolio.case.${index}.headline`}>{caseItem.headline}</span></span>
                  <div class="icon-wrapper relative w-4 h-4 overflow-hidden">
                    <svg class="icon-arrow absolute inset-0 transition-transform duration-300 group-hover:-translate-y-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14m-7-7 7 7-7 7"/>
                    </svg>
                    <svg class="icon-eye absolute inset-0 translate-y-full transition-transform duration-300 group-hover:translate-y-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                      <circle cx="12" cy="12" r="3"/>
                    </svg>
                  </div>
                </a>
              </div>
            </div>

          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .section-overline { opacity: 0.9; }
  
  .section-heading {
    background: linear-gradient(135deg, #ffffff 0%, #a8a29e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Reveal wrapper - inline-block dla dopasowania szerokości do treści */
  .case-content :global(.reveal-wrapper) {
    display: inline-block;
    width: auto;
  }

  /* Visual Link */
  .visual-link {
    display: block;
    cursor: pointer;
  }

  /* Visual Frame Animation Prep */
  .visual-frame {
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .case-card-wrapper.in-view .visual-frame {
    transform: translateY(0);
    opacity: 1;
  }

  .visual-link:hover .visual-frame {
    transform: scale(1.02);
    border-color: rgba(186, 245, 42, 0.2);
  }

  /* Image Reveal */
  [data-reveal-image] {
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s;
  }

  .case-card-wrapper.in-view [data-reveal-image] {
    opacity: 1;
  }

  /* Fade-in elements (metric & CTA) */
  [data-fade-in] {
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateY(10px);
  }

  .case-card-wrapper.in-view [data-fade-in] {
    opacity: 1 !important;
    transform: translateY(0);
  }

  /* Wiersz informacji (rok · czas · zespół) — tylko na /prace */
  .case-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    margin: -4px 0 18px;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.55);
  }
  .case-meta-dot { color: rgba(255, 255, 255, 0.25); }

  /* Kluczowy wynik — jeden stały układ: liczba nad etykietą, spięte linią z lewej.
     Wcześniej etykieta raz stała obok liczby, raz pod nią (zależnie od długości). */
  .case-result {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.15rem 0 0.15rem 0.9rem;
    border-left: 2px solid rgba(186, 245, 42, 0.55);
  }

  .case-result-value {
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #BAF52A;
    white-space: nowrap;
  }

  .case-result-label {
    max-width: 18rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    color: #a8a29e;
  }

  /* Metric badge - poprawione wyrównanie tekstu */
  .case-metric {
    height: auto;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .case-metric span {
    line-height: 1;
    padding: 1px 0;
  }

  /* CTA Button Enhanced Hover */
  .case-cta {
    position: relative;
  }

  .case-cta:hover {
    color: #BAF52A;
  }

  .icon-wrapper {
    position: relative;
    width: 16px;
    height: 16px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .icon-arrow,
  .icon-eye {
    position: absolute;
    inset: 0;
    width: 16px;
    height: 16px;
  }

  /* Tekst zawsze do lewej — w odwróconych kartach zmienia się tylko strona zdjęcia
     (wielowierszowe akapity wyrównane do prawej czyta się gorzej) */
  .case-content .case-metric,
  .case-content .case-cta {
    align-self: flex-start;
  }
</style>

<script>
  // Intersection Observer dla scroll-triggered animations
  const observerOptions = {
    threshold: 0.2,
    rootMargin: '0px 0px -10% 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.case-card-wrapper').forEach(card => {
    observer.observe(card);
  });
</script>