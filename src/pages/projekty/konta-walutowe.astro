---
import Layout from '../../layouts/Layout.astro';
import Reveal from '../../components/Reveal.astro';
import Footer from '../../components/Footer.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import CaseTldr from '../../components/CaseTldr.astro';

// Ekrany: placeholdery (.cs-placeholder) — do podmiany na <ProjectImage> z /images/ing/fx_*.webp
const project = {
  overline: "Finanse / Product Design",
  title: "Konta walutowe dla firm w ING",
  subtitle: "Jeden wniosek zamiast kilku kroków: konto w nowej walucie, karta i kantor w jednej ścieżce.",
  role: "UX Expert – Interaction Design",
  client: "ING Bank Śląski",
  year: "2026",
  scope: "Discovery · Badania · Prototypowanie z AI · UI",
  team: "15 osób (jedyny projektant)",
  duration: "2 miesiące",
  platforms: "Web · iOS · Android",
  learned: "Prototyp na starcie przyspiesza zespół, ale wymaga dyscypliny: trzeba jasno mówić, co jest mechaniką do sprawdzenia, a co danymi poglądowymi, żeby nikt nie wziął szkicu za specyfikację. Dziś od pierwszego dnia oznaczałbym w prototypie, które elementy są jeszcze do decyzji.",
  i18n: "fx",
};

const challenges = [
  { number: "01", title: "Prawdziwa potrzeba", description: "Konto w nowej walucie to dla klienta tylko środek. Celem jest udana transakcja z zagranicznym kontrahentem — bez szukania, co jeszcze trzeba włączyć." },
  { number: "02", title: "Kantor za osobnym wnioskiem", description: "Po otwarciu konta klient wchodził do kantoru i nie mógł z niego skorzystać. Najpierw musiał złożyć osobny wniosek, wyrazić zgody i przejść przez kilka dodatkowych ekranów." },
  { number: "03", title: "Nowe usługi poza ścieżką", description: "Karta wielowalutowa i inne nowe usługi dla firm już istniały, ale stary wniosek ich nie łączył. Klient sam musiał je odkryć i aktywować." },
];

const results = [
  { value: "3 → 1", label: "osobne procesy (konto, karta, zgody w kantorze) zastąpione jednym wnioskiem" },
  { value: "11", label: "walut obcych w ofercie dla firm (wcześniej 3)" },
  { value: "~1 mies.", label: "szybciej, niż zakładał harmonogram wdrożenia" },
];

const nextProjects = [
  { id: "blik",   overline: "Finanse / Strategia UX",             title: "BLIK dla Biznesu w ING", description: "Adaptacja retailowych wzorców płatniczych do złożonego ekosystemu bankowości korporacyjnej.", href: "/projekty/blik-dla-biznesu", image: "/images/ing/KV_blik.webp" },
  { id: "tabbox", overline: "HealthTech / Senior Care / IoT",       title: "TabBox — Ekosystem farmakoterapii", description: "Ekosystem łączący fizyczny dozownik leków z aplikacją mobilną.", href: "/projekty/tabbox", image: "/images/tabbox/KV_tabbox.webp" },
  { id: "vtda",   overline: "Bezpieczeństwo krytyczne / Deep Tech", title: "VTDA — Wirtualny Asystent Maszynisty", description: "Redukcja incydentów kolejowych o 20%. System wspomagania decyzji w czasie rzeczywistym.", href: "/projekty/vtda", image: "/images/vtda/VTDA_01.webp" },
];
---

<Layout title={`${project.title} | Kamil Wardak`} description={project.subtitle}>

  <!-- ─── PRELOADER BYPASS ───────────────────────────────────────────────── -->
  <script>
    // Na stronach projektów nie ma preloadera — odpalamy event natychmiast
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('preloaderFinished'));
      }, 100);
    });
  </script>

  <div class="bg-[#0c0a09] min-h-screen">

    <!-- ─── SPACER pod header ──────────────────────────────────────────────── -->
    <div class="h-20"></div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         HERO SECTION
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-hero relative px-6 pt-0 pb-0 md:pt-16 overflow-hidden">
      <div class="max-w-4xl mx-auto">

        <!-- Breadcrumb -->
        <div class="cs-breadcrumb mb-10 opacity-0" data-hero-fade style="--delay: 0s">
          <a href="/prace" class="cs-back-link group inline-flex items-center gap-2 text-white/50 text-sm font-medium transition-colors duration-300 hover:text-[#BAF52A]">
            <svg class="cs-back-arrow transition-transform duration-300 group-hover:-translate-x-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14m-7-7-7 7 7 7"/>
            </svg>
            <span data-i18n="cs.back">Wszystkie projekty</span>
          </a>
        </div>

        <!-- Overline label -->
        <div class="mb-5 opacity-0" data-hero-fade style="--delay: 0.05s">
          <Reveal trigger="onLoad" delay={0.15} color="#BAF52A">
            <p class="cs-overline text-[#BAF52A] text-xs tracking-[0.15em] font-bold" data-i18n={`${project.i18n}.overline`}>{project.overline}</p>
          </Reveal>
        </div>

        <!-- Main title -->
        <div class="mb-6">
          <Reveal trigger="onLoad" delay={0.3} duration={0.8} color="#ffffff">
            <h1 class="cs-hero-title text-white font-bold leading-[1.05] tracking-tight" data-i18n={`${project.i18n}.title`}>
              {project.title}
            </h1>
          </Reveal>
        </div>

        <!-- Subtitle -->
        <div class="max-w-2xl mb-12">
          <Reveal trigger="onLoad" delay={0.55} color="#a8a29e">
            <p class="cs-hero-subtitle text-stone-400 text-lg md:text-xl font-medium leading-relaxed" data-i18n={`${project.i18n}.subtitle`}>
              {project.subtitle}
            </p>
          </Reveal>
        </div>

        <!-- Meta strip -->
        <div class="cs-meta-strip opacity-0" data-hero-fade style="--delay: 0.7s">
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.role">Rola</span>
            <span class="cs-meta-value">{project.role}</span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.client">Klient</span>
            <span class="cs-meta-value">{project.client}</span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.when">Rok · czas</span>
            <span class="cs-meta-value">{project.year} · <span data-i18n={`${project.i18n}.duration`}>{project.duration}</span></span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.scope">Zakres</span>
            <span class="cs-meta-value" data-i18n={`${project.i18n}.scope`}>{project.scope}</span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.team">Zespół</span>
            <span class="cs-meta-value" data-i18n={`${project.i18n}.team`}>{project.team}</span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.platforms">Platformy</span>
            <span class="cs-meta-value" data-i18n={`${project.i18n}.platforms`}>{project.platforms}</span>
          </div>
        </div>


        <!-- TL;DR — problem, rola, wynik w trzech liniach -->
        <CaseTldr
          i18n={project.i18n}
          problem="Rozszerzyć wniosek o konto walutowe o 8 nowych walut. Wniosek powstał jednak, zanim bank wprowadził nowe usługi dla firm, a dostęp do kantoru wymagał osobnego wniosku i kilku dodatkowych zgód."
          role="UX Expert – Interaction Design, jedyny projektant w 15-osobowym zespole: eksploracja i analiza głosu klienta, prototyp, testy i finalne makiety."
          result="Trzy osobne procesy (konto, karta, zgody w kantorze) zastąpione jednym wnioskiem. Oferta urosła z 3 do 11 walut, wdrożenie było o około miesiąc szybsze od harmonogramu, a liczba nowych rachunków rośnie z miesiąca na miesiąc — jeszcze przed kampanią informacyjną."
        />
      </div>
    </section>

    <!-- ─── NOTA O POUFNOŚCI ─────────────────────────────────────────────── -->
    <section class="px-6 pt-8 pb-0">
      <div class="max-w-4xl mx-auto">
        <div class="cs-confidentiality-note opacity-0" data-hero-fade style="--delay: 0.85s">
          <svg class="cs-conf-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <p>
            <strong data-i18n={`${project.i18n}.conf.title`}>Nota o poufności:</strong> <span data-i18n={`${project.i18n}.conf`}>Ekrany zostały odtworzone na fikcyjnych danych. Case study opisuje proces i decyzje projektowe — sam produkt jest publicznie dostępny w Moim ING.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- ─── HERO IMAGE ─────────────────────────────────────────────────────── -->
    <section class="cs-hero-image-section px-6 pt-12 pb-0">
      <div class="max-w-4xl mx-auto">
        <div class="cs-hero-img-wrapper opacity-0" data-scroll-fade>
          <div class="aspect-[16/7] rounded-3xl overflow-hidden border border-white/5">
            <ProjectImage src="/images/ing/KV_fx.webp" alt="Wniosek o konto walutowe w aplikacji bankowej: podsumowanie z nowym kontem CHF, kartą wielowalutową i zgodami do kantoru; w tle wersja webowa kantoru i kody 11 walut" data-i18n-alt="fx.alt.KV_fx" class="w-full h-full object-cover cs-img" loading="eager" fetchpriority="high" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEKCJA 1 — KONTEKST
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-section px-6 pt-28 md:pt-36 pb-0">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-start">
          <div class="md:col-span-5">
            <Reveal delay={0.1} color="#BAF52A">
              <p class="cs-section-number">01</p>
            </Reveal>
            <Reveal delay={0.25} color="#ffffff">
              <h2 class="cs-section-heading mt-3 " data-i18n={`${project.i18n}.s1.heading`}>
                Od trzech walut do jedenastu
              </h2>
            </Reveal>
          </div>
          <div class="md:col-span-7">
            <Reveal delay={0.35} color="#a8a29e">
              <p class="cs-body-text mb-6" data-i18n={`${project.i18n}.s1.body1`}>
                Przedsiębiorcy w Moim ING mogli otworzyć konto w euro, dolarach lub funtach. Firmy pracujące z kontrahentami z innych krajów potrzebowały więcej — bank postanowił dodać osiem walut: SEK, CHF, NOK, DKK, CZK, HUF, TRY i RON.
              </p>
            </Reveal>
            <Reveal delay={0.5} color="#a8a29e">
              <p class="cs-body-text" data-i18n={`${project.i18n}.s1.body2`}>
                Początkowy zamysł był prosty: dopisać nowe waluty do istniejącego wniosku. W fazie eksploracji okazało się, że od czasu jego powstania bank wprowadził kilka nowych usług dla firm, których ta ścieżka w ogóle nie wykorzystywała.
              </p>
            </Reveal>
          </div>
        </div>

        <div class="cs-img-wrapper mt-16 opacity-0" data-scroll-fade>
          <div class="flex flex-col gap-10">
            <figure class="m-0 p-0">
              <div class="rounded-2xl overflow-hidden border border-white/5 bg-white">
                <ProjectImage src="/images/ing/fx_dotychczasowa_sciezka.webp" alt="Mapa ścieżki klienta przed zmianą: sześć kroków od sprawdzenia oferty (tylko EUR, USD, GBP) przez osobne podłączenie karty i dodatkowe zgody w kantorze, z emocjami klienta i głównymi barierami" data-i18n-alt="fx.alt.fx_dotychczasowa_sciezka" class="w-full h-auto block cs-img" loading="lazy" />
              </div>
              <figcaption class="cs-img-caption" data-i18n="fx.ph.0">Mapa dotychczasowej ścieżki — kliknij, aby powiększyć</figcaption>
            </figure>
            <figure class="m-0 p-0">
              <div class="rounded-2xl overflow-hidden border border-white/5 bg-white">
                <ProjectImage src="/images/ing/fx_glos_klienta.webp" alt="Głos klienta: trzy wypowiedzi przedsiębiorców o braku potrzebnych walut i rozliczeniach z zagranicznymi kontrahentami" data-i18n-alt="fx.alt.fx_glos_klienta" class="w-full h-auto block cs-img" loading="lazy" />
              </div>
              <figcaption class="cs-img-caption" data-i18n="fx.ph.1">Głos klienta — dosłowne cytaty z analizy opinii przedsiębiorców</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEKCJA 2 — ODKRYCIE
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-section cs-section--dark px-6 pt-28 md:pt-36 pb-28 md:pb-36">
      <div class="max-w-4xl mx-auto">
        <div class="mb-16 md:mb-20">
            <Reveal delay={0.1} color="#BAF52A">
              <p class="cs-section-number">02</p>
            </Reveal>
            <Reveal delay={0.25} color="#ffffff">
              <h2 class="cs-section-heading mt-3 max-w-xl" data-i18n={`${project.i18n}.s2.heading`}>
                Klient nie chce konta. Chce zapłacić kontrahentowi.
              </h2>
            </Reveal>
            <Reveal delay={0.4} color="#a8a29e">
              <p class="cs-body-text max-w-2xl mt-4" data-i18n={`${project.i18n}.s2.intro`}>
                Analiza głosu klientów z wewnętrznych zbiorów opinii banku zmieniła cel projektu: z „dodać waluty” na „doprowadzić do udanej transakcji”.
              </p>
            </Reveal>
        </div>

        <div class="cs-challenges-grid">
          {challenges.map((ch, i) => (
            <div class="cs-challenge-card opacity-0" data-scroll-fade style={`--fade-delay: ${0.1 + i * 0.15}s`}>
              <div class="cs-challenge-number">{ch.number}</div>
              <div class="cs-challenge-content">
                <h3 class="cs-challenge-title" data-i18n={`${project.i18n}.challenge.${i}.title`}>{ch.title}</h3>
                <p class="cs-challenge-desc" data-i18n={`${project.i18n}.challenge.${i}.desc`}>{ch.description}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-20 opacity-0" data-scroll-fade style="--fade-delay: 0.3s">
          <figure class="m-0 p-0">
              <div class="rounded-2xl overflow-hidden border border-white/5 bg-white">
                <ProjectImage src="/images/ing/fx_sciezka_przed_i_po.webp" alt="Porównanie ścieżki przed zmianą (cztery osobne procesy, 3 waluty) i po zmianie (jeden proces online: waluta, karta, umowy i zgody, podsumowanie, gotowe; 11 walut)" data-i18n-alt="fx.alt.fx_sciezka_przed_i_po" class="w-full h-auto block cs-img" loading="lazy" />
              </div>
              <figcaption class="cs-img-caption" data-i18n="fx.ph.2">Ścieżka przed zmianą i po niej — kliknij, aby powiększyć</figcaption>
            </figure>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEKCJA 3 — ROZWIĄZANIE
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-section px-6 pt-28 md:pt-36 pb-0">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-start">
          <div class="md:col-span-5 md:sticky md:top-28">
            <Reveal delay={0.1} color="#BAF52A">
              <p class="cs-section-number">03</p>
            </Reveal>
            <Reveal delay={0.25} color="#ffffff">
              <h2 class="cs-section-heading mt-3 " data-i18n={`${project.i18n}.s3.heading`}>
                Trzy kroki, jedna decyzja na krok
              </h2>
            </Reveal>
            <Reveal delay={0.4} color="#a8a29e">
              <p class="cs-body-text max-w-2xl mt-4" data-i18n={`${project.i18n}.s3.intro`}>
                Cały wniosek podzieliliśmy na etapy, w których klient podejmuje po jednej decyzji. Na końcu potwierdza wszystko kodem PIN.
              </p>
            </Reveal>
          </div>
          <div class="md:col-span-7 flex flex-col gap-10">
            <div class="cs-role-item opacity-0" data-scroll-fade style="--fade-delay: 0.1s">
              <div class="cs-role-tag" data-i18n={`${project.i18n}.role1.tag`}>Krok 1: waluta</div>
              <p class="cs-body-text mt-3" data-i18n={`${project.i18n}.role1.body`}>
                Klient wybiera, w jakiej walucie chce otworzyć nowe konto.
              </p>
            </div>
            <div class="cs-role-item opacity-0" data-scroll-fade style="--fade-delay: 0.2s">
              <div class="cs-role-tag" data-i18n={`${project.i18n}.role2.tag`}>Krok 2: karta</div>
              <p class="cs-body-text mt-3" data-i18n={`${project.i18n}.role2.body`}>
                Decyduje, czy zamawia nową kartę do konta, czy podpina je do karty wielowalutowej, którą już ma — albo pomija ten krok („Nie chcę teraz karty”). Nową kartę może odebrać w paczkomacie. Wniosek prowadzi do celu, ale nie wymusza produktu.
              </p>
            </div>
            <div class="cs-role-item opacity-0" data-scroll-fade style="--fade-delay: 0.3s">
              <div class="cs-role-tag" data-i18n={`${project.i18n}.role3.tag`}>Krok 3: dokumenty i kantor</div>
              <p class="cs-body-text mt-3" data-i18n={`${project.i18n}.role3.body`}>
                W jednej paczce dokumentów klient akceptuje umowę, regulaminy i zgody potrzebne do korzystania z kantoru. Po potwierdzeniu wniosku może od razu wymieniać waluty — bez osobnego wniosku.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-5 items-start opacity-0" data-scroll-fade>
          <figure class="m-0 p-0 w-full max-w-[300px] mx-auto md:max-w-none">
            <div class="aspect-[9/19.5] rounded-2xl overflow-hidden border border-white/5 bg-white">
              <ProjectImage src="/images/ing/fx_krok_01.webp" alt="Ekran kroku 1 wniosku: wybór waluty nowego konta (lista 11 walut) i częstotliwości wyciągu" data-i18n-alt="fx.alt.fx_krok_01" sizes="(min-width: 768px) 290px, 300px" class="w-full h-full object-cover object-top cs-img" loading="lazy" />
            </div>
            <figcaption class="cs-img-caption" data-i18n="fx.ph.4">Krok 1 — szczegóły: waluta i wyciąg</figcaption>
          </figure>
          <figure class="m-0 p-0 w-full max-w-[300px] mx-auto md:max-w-none">
            <div class="aspect-[9/19.5] rounded-2xl overflow-hidden border border-white/5 bg-white">
              <ProjectImage src="/images/ing/fx_krok_02.webp" alt="Ekran kroku 2: wybór karty — podpięcie konta do istniejącej karty wielowalutowej albo zamówienie nowej, karta wirtualna lub fizyczna" data-i18n-alt="fx.alt.fx_krok_02" sizes="(min-width: 768px) 290px, 300px" class="w-full h-full object-cover object-top cs-img" loading="lazy" />
            </div>
            <figcaption class="cs-img-caption" data-i18n="fx.ph.5">Krok 2 — karta: podpięcie istniejącej lub zamówienie nowej</figcaption>
          </figure>
          <figure class="m-0 p-0 w-full max-w-[300px] mx-auto md:max-w-none">
            <div class="aspect-[9/19.5] rounded-2xl overflow-hidden border border-white/5 bg-white">
              <ProjectImage src="/images/ing/fx_krok_03.webp" alt="Ekran kroku 3: dokumenty do pobrania (umowa, regulaminy i zgody do kantoru) oraz oświadczenie" data-i18n-alt="fx.alt.fx_krok_03" sizes="(min-width: 768px) 290px, 300px" class="w-full h-full object-cover object-top cs-img" loading="lazy" />
            </div>
            <figcaption class="cs-img-caption" data-i18n="fx.ph.6">Krok 3 — umowa i dokumenty, w tym zgody do kantoru</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEKCJA 4 — PROCES: PROTOTYP Z AI NA STARCIE
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-section cs-section--dark px-6 pt-28 md:pt-36 pb-28 md:pb-36">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-start">
          <div class="md:col-span-5 md:sticky md:top-28">
            <Reveal delay={0.1} color="#BAF52A">
              <p class="cs-section-number">04</p>
            </Reveal>
            <Reveal delay={0.25} color="#ffffff">
              <h2 class="cs-section-heading mt-3 " data-i18n={`${project.i18n}.s4.heading`}>
                Najpierw prototyp, potem makiety
              </h2>
            </Reveal>
            <Reveal delay={0.4} color="#a8a29e">
              <p class="cs-body-text max-w-2xl mt-4" data-i18n={`${project.i18n}.s4.intro`}>
