---
/* src/components/Footer.astro */
import LinkedInButton from './LinkedInButton.astro';
import ContactButtons from './ContactButtons.astro';

interface Props {
  /** Duże CTA „Masz złożony problem? Porozmawiajmy.” — wyłączone na stronie /kontakt */
  cta?: boolean;
}

const { cta = true } = Astro.props;

const navLinks = [
  { label: 'O mnie',    href: '/o-mnie',    key: 'footer.nav.about' },
  { label: 'Prace',     href: '/prace',     key: 'footer.nav.work' },
  { label: 'Podejście', href: '/podejscie', key: 'footer.nav.approach' },
];

const year = new Date().getFullYear();
---

<footer class={`footer relative bg-[#0c0a09] overflow-hidden px-6 pb-10 ${cta ? '' : 'footer--compact'}`}>

  <!-- Dekoracyjna wielka litera tła -->
  <span class="footer-bg-letter" aria-hidden="true">KW</span>

  <!-- Górna zielona linia -->
  <div class="max-w-4xl mx-auto">
    <div class={`w-full h-px bg-[#BAF52A]/20 ${cta ? 'mb-16' : 'mb-8'}`}></div>
  </div>

  <div class="max-w-4xl mx-auto relative z-10">

    <!-- GŁÓWNE CTA -->
    {cta && (
    <div class="footer-cta-block mb-20 md:mb-24">
      <p class="footer-label text-[#BAF52A] text-xs normalcase tracking-[0.2em] font-extrabold mb-5 opacity-0 footer-reveal" data-delay="0" data-i18n="footer.label">
        Zaczynamy?
      </p>

      <!-- Ten sam nagłówek i klucz tłumaczenia co na stronie /kontakt -->
      <h2 class="footer-headline opacity-0 footer-reveal" data-delay="80" data-i18n-html="contact.heading">
        Masz złożony problem? <br class="hidden md:block" /><span class="kt-accent">Porozmawiajmy.</span>
      </h2>

      <p class="footer-sub text-stone-400 text-base md:text-lg font-medium max-w-lg mt-6 leading-relaxed opacity-0 footer-reveal" data-delay="160" data-i18n="footer.sub">
        Szukam nowych wyzwań, w których mogę połączyć strategię, design i technologię. Napisz — szybko odpiszę.
      </p>

      <!-- Przyciski CTA -->
      <div class="mt-10 opacity-0 footer-reveal" data-delay="240">
        <ContactButtons />
      </div>
    </div>
    )}

    <!-- DOLNY PASEK -->
    {cta && <div class="w-full h-px bg-white/5 mb-8 opacity-0 footer-reveal" data-delay="320"></div>}

    <div class="footer-bottom opacity-0 footer-reveal" data-delay="380">
      <!-- Lewa: copyright -->
      <p class="footer-copy text-white/50 text-xs font-medium tracking-wide">
        © {year} Kamil Wardak. <span data-i18n="footer.copy">Wszelkie prawa zastrzeżone.</span>
      </p>

      <!-- Środek: nawigacja -->
      <nav class="footer-nav">
        {navLinks.map((link) => (
          <a href={link.href} class="footer-nav-link" data-i18n={link.key}>{link.label}</a>
        ))}
      </nav>

      <!-- Prawa: LinkedIn -->
      <div class="footer-social">
        <LinkedInButton />
      </div>
    </div>

  </div>

  <!-- Efekt świecenia z dołu -->
  <div class="footer-glow" aria-hidden="true"></div>
</footer>

<style>
  .footer {
    position: relative;
  }

  /* Dekoracyjna litera tła */
  .footer-bg-letter {
    position: absolute;
    bottom: -2rem;
    right: -2rem;
    font-size: clamp(8rem, 25vw, 18rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--brand-main);
    opacity: 0.025;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  /* Glow efekt na dole */
  .footer-glow {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #BAF52A, transparent);
    opacity: 0.35;
    pointer-events: none;
  }

  /* Wersja bez CTA (/kontakt) — stopka musi być co najmniej tak wysoka jak
     litery „KW”, inaczej overflow:hidden ucina je od góry */
  .footer--compact {
    min-height: clamp(8rem, 25vw, 18rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* mx-auto w kolumnie flex wyłącza rozciąganie — przywracamy pełną szerokość treści */
  .footer--compact > div:not(.footer-glow) { width: 100%; }

  /* Label */
  .footer-label {
    display: block;
  }

  /* Headline */
  .footer-headline {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: white;
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* :global — span wstawiany też przez tłumaczenia (innerHTML, bez atrybutu scope) */
  .footer-headline :global(.kt-accent) {
    background: linear-gradient(135deg, #BAF52A 0%, #e8ff8a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Dolny pasek */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer-copy {
    margin: 0;
    flex-shrink: 0;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .footer-nav-link {
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 0.3s ease;
    white-space: nowrap;
  }

  .footer-nav-link:hover {
    color: #BAF52A;
  }

  .footer-social {
    flex-shrink: 0;
  }

  /* Stany startowe dla animacji */
  .footer-reveal {
    transform: translateY(20px);
  }

  /* Responsywność */
  @media (max-width: 640px) {
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .footer-nav {
      gap: 1.5rem;
    }

    .footer-bg-letter {
      right: -1rem;
      bottom: -1rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const revealEls = document.querySelectorAll<HTMLElement>('.footer-reveal');
  let animated = false;

  const animateFooter = () => {
    if (animated) return;
    animated = true;
    revealEls.forEach((el) => {
      const delay = parseInt(el.dataset.delay || '0') / 1000;
      gsap.to(el, {
        opacity: 1,
        y: 0,
        duration: 0.75,
        delay,
        ease: 'power3.out',
      });
    });
  };

  const isInView = () => {
    const footer = document.querySelector('footer.footer');
    return !!footer && footer.getBoundingClientRect().top < window.innerHeight * 0.9;
  };

  // Standardowa ścieżka: scroll na normalnych stronach
  ScrollTrigger.create({
    trigger: 'footer.footer',
    start: 'top 85%',
    once: true,
    onEnter: animateFooter,
  });

  // Fallback 1: footer już w viewport przy załadowaniu (np. /kontakt wejście bezpośrednie)
  requestAnimationFrame(() => {
    if (isInView()) animateFooter();
  });

  // Fallback 2: po opadnięciu zasłony nawigacyjnej (desktop nav przez PageTransition)
  window.addEventListener('curtainDone', () => {
    requestAnimationFrame(() => {
      if (isInView()) animateFooter();
    });
  }, { once: true });
</script>