---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import HeroExpandImage from '../components/HeroExpandImage.astro';
import HeroExpandMobile from '../components/HeroExpandMobile.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import AproachSection from '../components/ApproachSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Kamil Wardak | Design Strategist">

  <div id="preloader" aria-hidden="true">
    <div class="preloader-content">
      <span id="welcome-text">∙ Cześć</span>
    </div>
  </div>

  <div class="bg-[#0c0a09]">
    <Hero />
    <HeroExpandImage />
    <HeroExpandMobile />
    <PortfolioSection />
    <AproachSection />
    <Footer />

     
  </div>

</Layout>



<script>
  const preloader = document.getElementById("preloader");
  const root = document.documentElement;

  // Klasę no-preloader ustawia <head> (Layout.astro): nawigacja wewnętrzna,
  // preloader już widziany w tej sesji albo prefers-reduced-motion.
  if (root.classList.contains('no-preloader')) {
    sessionStorage.removeItem('np');
    if (preloader) {
      preloader.style.display = 'none';       // twarde ukrycie niezależne od CSS
      preloader.classList.add('preloader-hidden');
    }
    document.body.style.removeProperty('overflow');
    // Usuwamy klasę dopiero po twardym ukryciu — bez ryzyka flashu
    root.classList.remove('no-preloader');

    // Bez zasłony (odświeżenie / wpisany adres) nikt nie wyśle curtainDone —
    // startujemy animacje strony sami, gdy wszystkie skrypty są już podpięte.
    if (!root.classList.contains('curtain-ready')) {
      document.addEventListener('DOMContentLoaded', () => {
        window.dispatchEvent(new CustomEvent('preloaderFinished'));
      }, { once: true });
    }
  } else {
    // Pierwsze wejście w sesji — krótki preloader (~1,8 s).
    // Mniej słów w spokojnym tempie zamiast wielu w pośpiechu (szybsze tempo = mruganie).
    const words = ["∙ Hello", "∙ こんにちは", "∙ Witaj"];
    const FADE_MS = 150;
    const HOLD_MS = 250;
    let currentIndex = 0;
    const textElement = document.getElementById("welcome-text");

    function updateText() {
      if (textElement && currentIndex < words.length) {
        textElement.style.opacity = "0";
        setTimeout(() => {
          textElement.textContent = words[currentIndex];
          textElement.style.opacity = "1";
          currentIndex++;
          setTimeout(updateText, HOLD_MS);
        }, FADE_MS);
      } else if (preloader) {
        setTimeout(() => {
          window.scrollTo(0, 0);
          preloader.classList.add("preloader-hidden");
          document.body.style.removeProperty('overflow');
          sessionStorage.setItem('preloaderSeen', '1');
          window.dispatchEvent(new CustomEvent('preloaderFinished'));
        }, 350);
      }
    }

    document.body.style.overflow = "hidden";
    setTimeout(updateText, 300);
  }
</script>



<style is:global>
  body { background-color: #0c0a09; margin: 0; }

  #preloader {
    position: fixed; inset: 0; background-color: #0c0a09;
    display: flex; justify-content: center; align-items: center;
    z-index: 9999; transition: transform 0.8s cubic-bezier(0.85, 0, 0.15, 1);
  }

  .preloader-hidden { transform: translateY(-100%); pointer-events: none; }
  #welcome-text { font-size: 2.5rem; font-weight: 700; color: #BAF52A; transition: opacity 0.15s; }
</style>