---
import Layout from '../../layouts/Layout.astro';
import Reveal from '../../components/Reveal.astro';
import Footer from '../../components/Footer.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import CaseTldr from '../../components/CaseTldr.astro';

const project = {
  overline: "Agenci AI / Strategia produktu",
  title: "MyOS: kontrola nad agentami AI w relacjach między firmami",
  subtitle: "Koncepcja produktu, w którym dwie firmy i ich agenci AI prowadzą relację na jednym, sprawdzalnym zapisie — a właściciel decyduje tylko tam, gdzie kończą się limity.",
  role: "Senior Product / UX Designer",
  client: "Blue Language Labs",
  year: "2026",
  scope: "Strategia produktu · Architektura informacji · Prototyp · Go-to-market",
  team: "Samodzielnie",
  platforms: "Web · mobile",
  duration: "Koncepcja · zadanie rekrutacyjne",
  learned: "Najtrudniejsze nie było projektowanie ekranów, tylko decyzja, czego właściciel firmy nie musi wiedzieć. Słowa protokołu (Mandate, PayNote, Timeline) zostawiłem w widoku dewelopera, a właścicielowi pokazałem limity, płatności i dowody. Nauczyłem się też od pierwszego ekranu oddzielać to, co działa dziś, od tego, co dopiero proponuję — każdy widok prototypu mówi o tym w stopce.",
  i18n: "myos",
};

const challenges = [
  {
    number: "01",
    title: "Jedna relacja w pięciu miejscach",
    description: "Umowy, zamówienia, uprawnienia agentów i pieniądze żyły w osobnych modułach. Żeby odpowiedzieć na pytanie „czy z Google wszystko w porządku?”, właściciel musiał odwiedzić każdy z nich.",
  },
  {
    number: "02",
    title: "Uprawnienia jako ustawienia",
    description: "Uprawnienia agentów wyglądały jak lista do administrowania. Nie odpowiadały na pytania, które zadaje właściciel: dlaczego to się stało i co jeszcze może się zmienić bez mojej zgody?",
  },
  {
    number: "03",
    title: "Aktywność zamiast stanu",
    description: "Kanały aktywności i czat mówiły, co się wydarzyło, ale nie co jest udowodnione, co jest należne i co wciąż czeka na dowód. Właściciel widział ruch, nie widział sytuacji.",
  },
];

// Kierunki rozważone i odrzucone (slajd „Rejected directions”)
const rejected = [
  { title: "Produkt oparty na umowie",          why: "centralny w briefie i prototypach zespołu.", no: "zbyt skupiony na dokumencie — ukrywa to, co dzieje się na co dzień." },
  { title: "Uprawnienia agentów na start",       why: "najbardziej charakterystyczny pomysł Blue.", no: "zbyt techniczny jako pierwsza historia dla właściciela." },
  { title: "Macierz uprawnień",                  why: "znany wzorzec z paneli administracyjnych.", no: "nie wyrazi cyklu życia, dowodu ani zakończenia." },
  { title: "Zespół jako schemat organizacyjny",  why: "widoczny w eksperymentach.", no: "sugeruje ludzi, a nie agentów działających w granicach." },
  { title: "Dashboard dla każdego modułu",       why: "łatwo przenieść z eksperymentów.", no: "rozbija jeden produkt na pięć." },
];

// Numerowane opisy na zbliżeniach (x, y w % kadru)
// Znaczniki stoją na marginesach i krawędziach elementów, żeby nie zasłaniać tekstu
const limitsMarks = [
  { x: 2.2,  y: 34.2, text: "Kto nadał odpowiedzialność, kto ją potwierdził i do kiedy obowiązuje." },
  { x: 2.2,  y: 61.4, text: "Prosta odpowiedź: co agent może, o co pyta, czego nie może nigdy i co robi bez dowodu." },
  { x: 67.6, y: 15.8, text: "Symulator: prawdziwe sytuacje sprawdzone, zanim uprawnienie zacznie działać." },
  { x: 58.4, y: 4,    text: "Zakończenie też jest zaprojektowane: co się zatrzymuje, co trwa dalej, co trzeba przekazać." },
];
const decisionMarks = [
  { x: 2.2,  y: 30,   text: "Trzy zasięgi decyzji: tylko to zamówienie, zmiana umowy albo zostawienie limitu." },
  { x: 67.2, y: 17.7, text: "Agent sprawdził warunki przed zapytaniem: kuchnię, dostawę i zabezpieczoną płatność." },
  { x: 35.7, y: 62.5, text: "Podgląd przed i po. Nic się jeszcze nie zmieniło." },
  { x: 2.2,  y: 91.9, text: "Bezpieczne zatwierdzenie: zmienia się tylko zamówienie #05, z możliwością cofnięcia do zamknięcia menu." },
];
const proofMarks = [
  { x: 2.2,  y: 47.7, text: "Deklaracja kuchni to jeszcze nie dowód — brakuje zapisu kuriera." },
  { x: 65.5, y: 60.6, text: "Dlatego kwota zostaje zabezpieczona i nie jest pobierana." },
  { x: 2.2,  y: 65.8, text: "Google dostaje prośbę o potwierdzenie — jego odpowiedź jest dowodem z umowy." },
  { x: 2.2,  y: 77.4, text: "Każdy fakt ma źródło: dostawca płatności, kurier, zdjęcie z kuchni, odpowiedź klienta." },
];

// Cztery stany uwagi (slajd „The system”)
const states = [
  { key: "done",    name: "W limitach",       desc: "Agent działał w granicach i ma na to dowód." },
  { key: "need",    name: "Potrzebuje Ciebie", desc: "Blokuje pracę albo ma termin." },
  { key: "wait",    name: "Czeka na dowód",    desc: "Nie da się tego jeszcze udowodnić. Pieniądze czekają." },
  { key: "denied",  name: "Niedozwolone",      desc: "Poza limitami. Po prostu się nie dzieje." },
];

// Napięcia z briefu i decyzje (slajd „Six tensions”)
const tensions = [
  { tension: "Wzrost na miarę vs wspólny rdzeń",      decision: "Strategia wzrostu jest indywidualna, a jej ustawienia stają się domyślnymi limitami na wspólnym rdzeniu." },
  { tension: "Rozmowa vs jawny stan",                  decision: "Asystent może wyjaśniać i wyszukiwać, ale stan żyje w prośbach o decyzję i czterech stanach — nie w czacie." },
  { tension: "Prostota vs prawda dla dewelopera",      decision: "Słowa biznesowe dla właściciela, a dokładny zapis Blue jedno kliknięcie głębiej." },
  { tension: "Autonomia vs kontrola człowieka",        decision: "Limity są testowane przed uruchomieniem, a decyzja na granicy ma wybrany zasięg." },
  { tension: "Otwarty protokół vs produkt",            decision: "MyOS jest marką produktu. Blue pokazuje się tam, gdzie pracują deweloperzy." },
  { tension: "Szybkość vs zaufanie",                   decision: "To, czego nie wiadomo, czeka zamiast zgadywać, a każdy etap wdrożenia kończy się bramką." },
];

const metrics = [
  "Interwencje właściciela na relację spadają, gdy relacji przybywa",
  "Właściciele przewidują skutek decyzji, zanim ją podejmą",
  "Czas od wyjątku do decyzji",
  "Zero akcji poza limitami",
  "Druga relacja bez dedykowanego kodu",
];

const phases = [
  { days: "Dni 0–30",  title: "Zweryfikować model",       body: "Architektura oparta na relacji, słownictwo, zasięg decyzji.",        gate: "właściciele przewidują skutki bez znajomości protokołu" },
  { days: "Dni 31–60", title: "Jedna pełna pętla",         body: "Umowa, zamówienie, limit, decyzja, płatność i dowód.",              gate: "rutyna działa bezpiecznie, a wyjątki wracają z kontekstem" },
  { days: "Dni 61–90", title: "Udowodnić powtarzalność",   body: "Drugi kontrahent i diagnostyka dla deweloperów.",                   gate: "kolejna relacja bez dedykowanej logiki" },
];

const nextProjects = [
  { id: "fx",   overline: "Finanse / Product Design",          title: "Konta walutowe dla firm w ING", description: "Jeden wniosek: konto w nowej walucie, karta i kantor. 11 walut obcych dla firm.", href: "/projekty/konta-walutowe", image: "/images/ing/KV_fx.webp" },
  { id: "blik", overline: "Finanse / Strategia UX",            title: "BLIK dla Biznesu w ING", description: "Adaptacja retailowych wzorców płatniczych do złożonego ekosystemu bankowości korporacyjnej.", href: "/projekty/blik-dla-biznesu", image: "/images/ing/KV_blik.webp" },
  { id: "reid", overline: "Bezpieczeństwo / Computer Vision", title: "System reidentyfikacji osób dla infrastruktury krytycznej", description: "Integracja zaawansowanego rzemiosła UX z systemami wizyjnymi AI. 20% ROI w 6 miesięcy.", href: "/projekty/reid", image: "/images/reid/hero_reid.webp" },
];
---

<Layout title={`${project.title} | Kamil Wardak`} description={project.subtitle}>

  <!-- ─── PRELOADER BYPASS ───────────────────────────────────────────────── -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('preloaderFinished'));
      }, 100);
    });
  </script>

  <div class="bg-[#0c0a09] min-h-screen">

    <!-- ─── SPACER pod header ──────────────────────────────────────────────── -->
    <div class="h-20"></div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         HERO SECTION
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-hero relative px-6 pt-0 pb-0 md:pt-16 overflow-hidden">
      <div class="max-w-4xl mx-auto">

        <!-- Breadcrumb -->
        <div class="cs-breadcrumb mb-10 opacity-0" data-hero-fade style="--delay: 0s">
          <a href="/prace" class="cs-back-link group inline-flex items-center gap-2 text-white/50 text-sm font-medium transition-colors duration-300 hover:text-[#BAF52A]">
            <svg class="cs-back-arrow transition-transform duration-300 group-hover:-translate-x-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14m-7-7-7 7 7 7"/>
            </svg>
            <span data-i18n="cs.back">Wszystkie projekty</span>
          </a>
        </div>

        <!-- Overline label -->
        <div class="mb-5 opacity-0" data-hero-fade style="--delay: 0.05s">
          <Reveal trigger="onLoad" delay={0.15} color="#BAF52A">
            <p class="cs-overline text-[#BAF52A] text-xs tracking-[0.15em] font-bold" data-i18n={`${project.i18n}.overline`}>{project.overline}</p>
          </Reveal>
        </div>

        <!-- Main title -->
        <div class="mb-6">
          <Reveal trigger="onLoad" delay={0.3} duration={0.8} color="#ffffff">
            <h1 class="cs-hero-title text-white font-bold leading-[1.05] tracking-tight" data-i18n={`${project.i18n}.title`}>
              {project.title}
            </h1>
          </Reveal>
        </div>

        <!-- Subtitle -->
        <div class="max-w-2xl mb-12">
          <Reveal trigger="onLoad" delay={0.55} color="#a8a29e">
            <p class="cs-hero-subtitle text-stone-400 text-lg md:text-xl font-medium leading-relaxed" data-i18n={`${project.i18n}.subtitle`}>
              {project.subtitle}
            </p>
          </Reveal>
        </div>

        <!-- Meta strip -->
        <div class="cs-meta-strip opacity-0" data-hero-fade style="--delay: 0.7s">
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.role">Rola</span>
            <span class="cs-meta-value">{project.role}</span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n={`${project.i18n}.meta.for`}>Dla</span>
            <span class="cs-meta-value">{project.client}</span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n={`${project.i18n}.meta.when`}>Rok · status</span>
            <span class="cs-meta-value">{project.year} · <span data-i18n={`${project.i18n}.duration`}>{project.duration}</span></span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.scope">Zakres</span>
            <span class="cs-meta-value" data-i18n={`${project.i18n}.scope`}>{project.scope}</span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.team">Zespół</span>
            <span class="cs-meta-value" data-i18n={`${project.i18n}.team`}>{project.team}</span>
          </div>
          <div class="cs-meta-divider"></div>
          <div class="cs-meta-item">
            <span class="cs-meta-label" data-i18n="cs.meta.platforms">Platformy</span>
            <span class="cs-meta-value" data-i18n={`${project.i18n}.platforms`}>{project.platforms}</span>
          </div>
        </div>


        <!-- TL;DR — problem, rola, wynik w trzech liniach -->
        <CaseTldr
          i18n={project.i18n}
          problem="Firmy oddają agentom AI coraz więcej pracy: umowy, zamówienia, płatności. Właściciel musi wiedzieć, co agent może zrobić bez niego, co wymaga jego decyzji i na jakiej podstawie system uznaje coś za fakt — bez znajomości protokołu, na którym to działa."
          role="Senior Product / UX Designer, samodzielnie: model produktu, architektura informacji, system stanów, klikalny prototyp zbudowany z pomocą Claude, go-to-market i plan badań."
          result="Według feedbacku firmy moja propozycja była jedną z najsilniejszych w procesie rekrutacji. Po trudnych decyzjach nie przeszedłem do etapu finałowego — została koncepcja i prototyp w trzech aktach."
        />
      </div>
    </section>

    <!-- ─── NOTA: KONCEPCJA, NIE WDROŻENIE ───────────────────────────────── -->
    <section class="px-6 pt-8 pb-0">
      <div class="max-w-4xl mx-auto">
        <div class="cs-confidentiality-note opacity-0" data-hero-fade style="--delay: 0.85s">
          <svg class="cs-conf-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 16v-4M12 8h.01"/>
          </svg>
          <p>
            <strong data-i18n={`${project.i18n}.conf.title`}>Koncepcja, nie wdrożenie:</strong> <span data-i18n={`${project.i18n}.conf`}>ekrany pochodzą z mojego prototypu, a scenariusz z Google NYC i kwoty na nich są poglądowe.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- ─── HERO IMAGE ─────────────────────────────────────────────────────── -->
    <section class="cs-hero-image-section px-6 pt-12 pb-0">
      <div class="max-w-4xl mx-auto">
        <div class="cs-hero-img-wrapper opacity-0" data-scroll-fade>
          <div class="aspect-[16/8] rounded-3xl overflow-hidden border border-white/5">
            <ProjectImage src="/images/myos/hero_myos.webp" alt="Grafika projektu MyOS: okno przeglądarki z decyzją „Allow 56 meals when the Agreement allows 55?”, obok telefon z widokiem Today, nad nimi pasek Agreement v3 łączący Chama Mama i Google oraz etykiety stanów: Needs you, Waiting for proof, Done within limits" data-i18n-alt="myos.alt.hero" class="w-full h-full object-cover cs-img" loading="eager" fetchpriority="high" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEKCJA 1 — KONTEKST
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-section px-6 pt-28 md:pt-36 pb-0">
      <div class="max-w-4xl mx-auto">

        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-start">

          <!-- Left: Number + heading -->
          <div class="md:col-span-5">
            <Reveal delay={0.1} color="#BAF52A">
              <p class="cs-section-number">01</p>
            </Reveal>
            <Reveal delay={0.25} color="#ffffff">
              <h2 class="cs-section-heading mt-3" data-i18n={`${project.i18n}.s1.heading`}>
                Agenci prowadzą firmę. Kto za nich odpowiada?
              </h2>
            </Reveal>
          </div>

          <!-- Right: Body text -->
          <div class="md:col-span-7">
            <Reveal delay={0.35} color="#a8a29e">
              <p class="cs-body-text mb-6" data-i18n={`${project.i18n}.s1.body1`}>
                Blue Language Labs buduje Blue — otwarty język dokumentów, w którym umowa, zamówienie czy uprawnienie agenta są dokładnym, wersjonowanym zapisem, a nie plikiem PDF i prywatnym kodem. MyOS to środowisko, w którym firmy i ich agenci AI na tych dokumentach pracują.
              </p>
            </Reveal>
            <Reveal delay={0.5} color="#a8a29e">
              <p class="cs-body-text" data-i18n={`${project.i18n}.s1.body2`}>
                Zadanie nie dotyczyło odświeżenia interfejsu. Miałem zdecydować, czym MyOS powinien się stać, i sprawić, żeby właściciel restauracji zrozumiał produkt bez nauki protokołu. Brief wprost oceniał model produktu, architekturę interakcji, warsztat wizualny i osąd go-to-market.
              </p>
            </Reveal>
          </div>

        </div>

        <!-- Context images -->
        <div class="cs-img-wrapper mt-16 opacity-0" data-scroll-fade>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <figure class="m-0 p-0">
              <div class="aspect-[16/10] rounded-2xl overflow-hidden border border-white/5">
                <ProjectImage src="/images/myos/today_myos.webp" sizes="(min-width: 944px) 440px, calc(100vw - 48px)" alt="Widok Today: na górze decyzje, które wymagają właściciela, niżej zamówienia czekające na dowód i prace wykonane przez agentów w ich limitach" data-i18n-alt="myos.alt.today" class="w-full h-full object-cover object-top cs-img" loading="lazy" />
              </div>
              <figcaption class="cs-img-caption" data-i18n="myos.caption.0">Today — raport pracy agentów: najpierw to, co wymaga Twojej decyzji</figcaption>
            </figure>
            <figure class="m-0 p-0">
              <div class="aspect-[16/10] rounded-2xl overflow-hidden border border-white/5">
                <ProjectImage src="/images/myos/strategy_myos.webp" sizes="(min-width: 944px) 440px, calc(100vw - 48px)" alt="Strategia wzrostu „Office catering outreach”: propozycja pilotażu z Etsy HQ do akceptacji, lejek miesiąca i limity zapisane raz dla całej strategii" data-i18n-alt="myos.alt.strategy" class="w-full h-full object-cover object-top cs-img" loading="lazy" />
              </div>
              <figcaption class="cs-img-caption" data-i18n="myos.caption.1">Growth — właściciel zatwierdza strategię raz, a jej limity obowiązują w każdej nowej relacji</figcaption>
            </figure>
          </div>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEKCJA 2 — PROBLEMY
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-section cs-section--dark px-6 pt-28 md:pt-36 pb-28 md:pb-36">
      <div class="max-w-4xl mx-auto">

        <!-- Section header -->
        <div class="mb-16 md:mb-20">
          <Reveal delay={0.1} color="#BAF52A">
            <p class="cs-section-number">02</p>
          </Reveal>
          <Reveal delay={0.25} color="#ffffff">
            <h2 class="cs-section-heading mt-3 max-w-xl" data-i18n={`${project.i18n}.s2.heading`}>
              MyOS myślał dokumentami. Właściciele myślą relacjami.
            </h2>
          </Reveal>
          <Reveal delay={0.4} color="#a8a29e">
            <p class="cs-body-text max-w-2xl mt-4" data-i18n={`${project.i18n}.s2.intro`}>
              Eksperymenty pokazały, że podstawowe elementy działają. Brakowało jednego modelu produktu, który je łączy. W materiałach znalazłem trzy powtarzające się problemy.
            </p>
          </Reveal>
        </div>

        <!-- Challenge cards -->
        <div class="cs-challenges-grid">
          {challenges.map((ch, i) => (
            <div class="cs-challenge-card opacity-0" data-scroll-fade style={`--fade-delay: ${0.1 + i * 0.15}s`}>
              <div class="cs-challenge-number">{ch.number}</div>
              <div class="cs-challenge-content">
                <h3 class="cs-challenge-title" data-i18n={`${project.i18n}.challenge.${i}.title`}>{ch.title}</h3>
                <p class="cs-challenge-desc" data-i18n={`${project.i18n}.challenge.${i}.desc`}>{ch.description}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Relacja jako produkt -->
        <div class="mt-20 opacity-0" data-scroll-fade style="--fade-delay: 0.3s">
          <figure class="m-0 p-0">
            <div class="aspect-[16/10] rounded-3xl overflow-hidden border border-white/5">
              <ProjectImage src="/images/myos/relationship_myos.webp" alt="Relacja Chama Mama i Google NYC: Agreement v3 łączy obie firmy, pod spodem kwoty zabezpieczone i wypłacone, sześć zakładek relacji i decyzja o 56 posiłkach; z prawej osoby i agenci zaangażowani w relację" data-i18n-alt="myos.alt.relationship" class="w-full h-full object-cover object-top cs-img" loading="lazy" />
            </div>
            <figcaption class="cs-img-caption" data-i18n="myos.caption.2">Relacja jako produkt — umowa, zamówienia, pieniądze, limity i dowody w jednym miejscu</figcaption>
          </figure>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEKCJA 3 — DROGA DO TEZY
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="cs-section px-6 pt-28 md:pt-36 pb-0">
      <div class="max-w-4xl mx-auto">

