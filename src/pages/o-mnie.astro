---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/images/portret_portfolio.webp';
import Button from '../components/Button.astro';

const pillars = [
  {
    number: "01",
    title: "UX jako inwestycja, nie koszt",
    body: "Pokazuję interesariuszom, jak decyzje projektowe oparte na danych przekładają się na lojalność klientów i konwersję — także w najbardziej złożonych procesach transakcyjnych."
  },
  {
    number: "02",
    title: "Odpowiedzialność w systemach krytycznych",
    body: "Projektuję tam, gdzie nie ma miejsca na domysły — od bankowości po biometrię. Przemyślana architektura informacji ogranicza błędy ludzkie tam, gdzie chodzi o pieniądze i poufne dane."
  },
  {
    number: "03",
    title: "Produkty na styku świata cyfrowego i fizycznego",
    body: "Projektowałem rozwiązania, w których aplikacja współpracuje z urządzeniem lub pracą w terenie: dozownik leków, kabina maszynisty, sieć kamer. Łączę wymagania regulacyjne z tym, jak ludzie naprawdę zachowują się na co dzień."
  }
];

type Tool =
  | { name: string; category: string; slug: string; svg?: never }
  | { name: string; category: string; svg: string; slug?: never };

interface ToolGroup {
  label: string;
  tools: Tool[];
}

const toolGroups: ToolGroup[] = [
  {
    label: "Projektowanie i prototypowanie",
    tools: [
      { name: "Figma", category: "Design systemy i interfejsy", slug: "figma" },
      {
        name: "ProtoPie",
        category: "Zaawansowane prototypy",
        svg: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9.5" stroke="rgba(255,255,255,0.85)" stroke-width="1.8"/><path d="M12 3v9h9" stroke="rgba(255,255,255,0.85)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.2" fill="rgba(255,255,255,0.85)"/></svg>'
      },
      { name: "Framer", category: "Animacja i interakcje", slug: "framer" },
      { name: "Adobe CC", category: "Grafika i wideo", slug: "adobecreativecloud" },
    ]
  },
  {
    label: "Współpraca",
    tools: [
      { name: "Miro", category: "Warsztaty i service design", slug: "miro" },
      { name: "Notion", category: "Dokumentacja", slug: "notion" },
    ]
  },
  {
    label: "AI",
    tools: [
      { name: "Claude", category: "Analiza, synteza, UX writing", slug: "claude" },
      { name: "ChatGPT", category: "Ideacja", slug: "openai" },
    ]
  }
];

// Oś czasu — dane z CV; role zgodne z case study (tłumaczenia: about.exp.N.*)
const experience = [
  {
    period: "05.2024 – obecnie",
    company: "ING Bank Śląski · Business Banking",
    role: "UX Expert – Interaction Design",
    desc: "Zespół centralny bankowości firmowej: projekty w obszarach płatności, kart, BLIK i GenAI — od discovery po wdrożenie. M.in. BLIK dla Biznesu, asystent GenAI i międzynarodowa gildia projektowa ING.",
    href: "/projekty/blik-dla-biznesu",
  },
  {
    period: "01.2024 – 09.2024",
    company: "Hack the Climate · PFR",
    role: "Lead UX & UI Designer",
    desc: "Platforma klimatyczna dla mieszkańców Rzeszowa. Wyróżnienie w konkursie Polskiego Funduszu Rozwoju.",
  },
  {
    period: "01.2023 – 12.2023",
    company: "New Security Systems",
    role: "Lead UX & UI Designer",
    desc: "Lider 4-osobowego zespołu. SaaS do reidentyfikacji biometrycznej dla infrastruktury krytycznej (REID).",
    href: "/projekty/reid",
  },
  {
    period: "01.2023 – 07.2023",
    company: "TabBox",
    role: "Lead Product Designer",
    desc: "Lider 3-osobowego zespołu (pół etatu). Inteligentny dozownik leków dla seniorów — od koncepcji po masową produkcję.",
    href: "/projekty/tabbox",
  },
  {
    period: "01.2023 – 07.2023",
    company: "PGZ Stocznia Wojenna · PFR",
    role: "Lead Product Designer",
    desc: "System wykrywania anomalii morskich oparty na sieciach neuronowych, wdrożony operacyjnie u kontraktora.",
  },
  {
    period: "04.2021 – 12.2022",
    company: "Infracert",
    role: "Lead UX & UI Designer",
    desc: "VTDA — system wsparcia maszynistów dla przewoźników kolejowych z Europy Środkowo-Wschodniej.",
    href: "/projekty/vtda",
  },
  {
    period: "2014 – 2021",
    company: "Freelance · R&B Studio · in-house",
    role: "Product Designer · Graphic Designer",
    desc: "Siedem lat pracy z agencjami i klientami bezpośrednimi: branding, layout, motion i pierwsze projekty produktowe.",
  },
];

const education = [
  { year: "2020 – 2024", title: "Magister sztuki", org: "Polsko-Japońska Akademia Technik Komputerowych" },
  { year: "2024", title: "Google UX Design Professional Certificate", org: "Google" },
  { year: "2026", title: "Umiejętności Jutra 3.0", org: "Google i SGH" },
];
---

<Layout title="O mnie | Kamil Wardak" description="Poznaj Kamila Wardaka — 12 lat doświadczenia w projektowaniu produktów cyfrowych dla bankowości, HealthTech i sektora obronnego. Obecnie ING Bank Śląski.">

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('preloaderFinished'));
      }, 100);
    });
  </script>

  <div class="bg-[#0c0a09] min-h-screen">

    <!-- ═══════════════════════════════════════════════════════════════════════
         HERO — pełna szerokość nagłówka, zdjęcie poniżej
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="relative px-6 pt-16 md:pt-24 pb-24 md:pb-36 overflow-hidden">

      <div class="hero-bg-glow" aria-hidden="true"></div>

      <div class="max-w-4xl mx-auto">

        <!-- ── Overline + pełna szerokość nagłówka ── -->
        <div class="mb-5 opacity-0" data-hero-fade style="--delay: 0s">
          <p class="om-overline" data-i18n="about.overline">Design Strategist & Lead UX Designer · 12 lat doświadczenia</p>
        </div>

        <h1 class="om-headline opacity-0" data-hero-fade style="--delay: 0.07s">
          <span data-i18n-html="about.headline">Projektuję produkty,<br/>którym ludzie mogą <span class="om-headline-accent">zaufać.</span></span>
        </h1>

        <!-- ── Bio + zdjęcie side-by-side ── -->
        <div class="grid grid-cols-1 md:grid-cols-[1fr_260px] gap-12 md:gap-14 mt-6 items-start">

          <!-- Lewa: lead text + stats -->
          <div>
            <p class="om-lead opacity-0" data-hero-fade style="--delay: 0.14s" data-i18n="about.lead">
              Od 12 lat projektuję produkty tam, gdzie błąd kosztuje: w bankowości, medycynie, transporcie kolejowym i bezpieczeństwie. Zaczynałem od grafiki i montażu wideo, dziś łączę rzemiosło projektowe ze strategią produktu i wdrażaniem GenAI.
            </p>

            <div class="om-stats-grid mt-12 pt-10 border-t border-white/[0.07] opacity-0" data-hero-fade style="--delay: 0.21s">
              <div class="om-stat">
                <p class="om-stat-value">12+</p>
                <p class="om-stat-label" data-i18n="about.stat.years">lat doświadczenia</p>
              </div>
              <div class="om-stat-divider" aria-hidden="true"></div>
              <div class="om-stat">
                <p class="om-stat-value om-stat-value--white">4</p>
                <p class="om-stat-label" data-i18n-html="about.stat.sectors">sektory — FinTech, Security,<br/>MedTech, Transport</p>
              </div>
              <div class="om-stat-divider" aria-hidden="true"></div>
              <div class="om-stat">
                <p class="om-stat-value om-stat-value--white" data-i18n="about.stat.deployments.value">60 dni</p>
                <p class="om-stat-label" data-i18n-html="about.stat.deployments">od startu do wdrożenia<br/>(REID)</p>
              </div>
            </div>
          </div>

          <!-- Prawa: zdjęcie -->
          <div class="om-photo-wrap opacity-0" data-hero-fade style="--delay: 0.1s">
            <div class="om-photo-frame">
              <Image
                src={heroPhoto}
                alt="Kamil Wardak — Design Strategist & Lead UX Designer"
                width={520}
                height={660}
                loading="eager"
                class="om-photo"
              />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DOŚWIADCZENIE — oś czasu + wykształcenie
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="px-6 pt-8 md:pt-12 pb-8" aria-labelledby="om-exp-heading">
      <div class="max-w-4xl mx-auto">

        <div class="mb-12 md:mb-16 opacity-0" data-scroll-fade>
          <p class="text-[#BAF52A] text-xs tracking-[0.15em] font-bold mb-5" data-i18n="about.exp.overline">Kariera</p>
          <h2 class="om-section-heading" id="om-exp-heading" data-i18n="about.exp.heading">Doświadczenie zawodowe</h2>
        </div>

        <ol class="om-timeline" role="list">
          {experience.map((job, i) => (
            <li class="om-job opacity-0" data-scroll-fade style={`--fade-delay: ${0.05 + i * 0.06}s`}>
              <p class="om-job-period" data-i18n={`about.exp.${i}.period`}>{job.period}</p>
              <div class="om-job-body">
                <h3 class="om-job-role" data-i18n={`about.exp.${i}.role`}>{job.role}</h3>
                <p class="om-job-company">{job.company}</p>
                <p class="om-job-desc" data-i18n={`about.exp.${i}.desc`}>{job.desc}</p>
                {job.href && (
                  <a href={job.href} class="om-job-link">
                    <span data-i18n="about.exp.case">Zobacz case study</span>
                    <span class="sr-only"> — {job.company}</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>

        <div class="om-edu opacity-0" data-scroll-fade>
          <h3 class="om-edu-heading" data-i18n="about.edu.heading">Wykształcenie i certyfikaty</h3>
          <ul class="om-edu-list" role="list">
            {education.map((e, i) => (
              <li class="om-edu-item">
                <span class="om-edu-year">{e.year}</span>
                <span class="om-edu-title" data-i18n={`about.edu.${i}.title`}>{e.title}</span>
                <span class="om-edu-org" data-i18n={`about.edu.${i}.org`}>{e.org}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-12 opacity-0" data-scroll-fade>
          <Button text="Pobierz pełne CV" i18nKey="about.exp.cv" hrefI18nKey="hero.cta.cv.href" variant="secondary" href="/Kamil_Wardak_CV_2026.pdf" download={true}>
            <svg slot="icon-default" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            <span slot="icon-hover" class="file-size">1.3 MB</span>
          </Button>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FILOZOFIA — 3 FILARY
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="px-6 pt-24 md:pt-32 pb-24 md:pb-32">
      <div class="max-w-4xl mx-auto">

        <div class="mb-16 md:mb-20 opacity-0" data-scroll-fade>
          <p class="text-[#BAF52A] text-xs tracking-[0.15em] font-bold mb-5" data-i18n="about.philosophy.overline">
            Jak myślę
          </p>
          <h2 class="om-section-heading max-w-2xl" data-i18n="about.philosophy.heading">
            Przekonania, które kształtują każdy projekt
          </h2>
        </div>

        <div class="om-pillars-grid">
          {pillars.map((p, i) => (
            <div
              class="om-pillar opacity-0"
              data-scroll-fade
              style={`--fade-delay: ${0.1 + i * 0.12}s`}
            >
              <p class="om-pillar-number">{p.number}</p>
              <div class="om-pillar-content">
                <h3 class="om-pillar-title" data-i18n={`about.pillar.${i}.title`}>{p.title}</h3>
                <p class="om-pillar-body" data-i18n={`about.pillar.${i}.body`}>{p.body}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="om-quote-block mt-20 opacity-0" data-scroll-fade style="--fade-delay: 0.3s">
          <div class="om-quote-line" aria-hidden="true"></div>
          <p class="om-personal-label" data-i18n="about.personal.label">Poza projektami</p>
          <p class="om-quote-text om-personal-text" data-i18n="about.quote">
            Pracuję po angielsku (C1), dogaduję się po niemiecku (B1) i uczę się japońskiego. Poza pracą najchętniej spędzam czas w naturze — to ona najlepiej uczy, jak żyć w harmonii.
          </p>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════
         TOOL STACK
    ════════════════════════════════════════════════════════════════════════ -->
    <section class="px-6 pt-24 md:pt-32 pb-32 md:pb-40">
      <div class="max-w-4xl mx-auto">

        <div class="mb-6 opacity-0" data-scroll-fade>
          <p class="text-[#BAF52A] text-xs tracking-[0.15em] font-bold mb-5" data-i18n="about.tools.overline">
            Warsztat
          </p>
          <h2 class="om-section-heading" data-i18n="about.tools.heading">
            Narzędzia, z których korzystam
          </h2>
          <p class="om-section-sub" data-i18n="about.tools.desc">
            Używam AI, żeby przyspieszyć rzemiosło, a nie zastąpić myślenie. Zostaje mi więcej czasu na strategię, analizę ryzyk i rozmowy z użytkownikami.
          </p>
        </div>

        <!-- FEATURED: Claude -->
        <div class="om-claude-feature opacity-0" data-scroll-fade style="--fade-delay: 0.08s">
          <div class="om-claude-logo-wrap">
            <img
              src="https://cdn.simpleicons.org/claude/CC785C"
              alt="Claude"
              width="38"
              height="38"
              class="om-claude-img"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
            />
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="om-claude-svg" style="display:none" aria-hidden="true">
              <path d="M19.1 3.5h-6.2L4.5 28.5h5.7l2-5.7h9.6l2 5.7h5.7L19.1 3.5zm-5.1 15.3L16 10.9l2 7.9h-4z" fill="#CC785C"/>
            </svg>
          </div>
          <div class="om-claude-text">
            <div class="om-claude-badge" data-i18n="about.claude.badge">Główne narzędzie AI</div>
            <h3 class="om-claude-name">Claude <span class="om-claude-by">by Anthropic</span></h3>
            <p class="om-claude-desc" data-i18n="about.claude.desc">
              Używam go do analizy logiki biznesowej, wyszukiwania przypadków brzegowych, syntezy badań i UX writingu.
            </p>
            <div class="om-claude-tags">
              <span data-i18n="about.claude.tag.0">Analiza logiki</span>
              <span data-i18n="about.claude.tag.1">Przypadki brzegowe</span>
              <span data-i18n="about.claude.tag.2">UX writing</span>
              <span data-i18n="about.claude.tag.3">Strategia</span>
            </div>
          </div>
        </div>

        <!-- Grupy narzędzi -->
        {toolGroups.map((group, gi) => (
          <div class="mt-16 opacity-0" data-scroll-fade style={`--fade-delay: ${0.1 + gi * 0.1}s`}>
            <p class="om-group-label" data-i18n={`about.toolgroup.${gi}`}>{group.label}</p>
            <div class="om-tools-grid mt-6">
              {group.tools.map((tool, ti) => (
                <div class="om-tool-card">
                  <div class="om-tool-logo">
                    {tool.svg ? (
                      <span class="om-tool-svg-wrap" set:html={tool.svg} />
                    ) : (
                      <>
                        <img
                          src={`https://cdn.simpleicons.org/${tool.slug}/ffffff`}
                          alt={tool.name}
                          width="26"
                          height="26"
                          loading="lazy"
                          class="om-tool-img"
                          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                        />
                        <div class="om-tool-fallback" style="display:none">
                          {tool.name.charAt(0)}
                        </div>
                      </>
                    )}
                  </div>
                  <div class="om-tool-info">
                    <p class="om-tool-name">{tool.name}</p>
                    <p class="om-tool-cat" data-i18n={`about.tools.g${gi}.t${ti}.cat`}>{tool.category}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}

      </div>
    </section>

    <Footer />
  </div>
</Layout>

<style>

  /* ─── Tło hero ──────────────────────────────────────────────────────────── */

  .hero-bg-glow {
    position: absolute;
    top: -120px;
    right: -200px;
    width: 700px;
    height: 700px;
    background: radial-gradient(ellipse at center, rgba(186,245,42,0.06) 0%, transparent 65%);
    pointer-events: none;
  }

  /* ─── Overline ──────────────────────────────────────────────────────────── */

  .om-overline {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #BAF52A;
    margin: 0;
  }

  /* ─── Headline ──────────────────────────────────────────────────────────── */

  /* Rozmiar i grubość jak tytuł na stronie głównej (.hero-title w Hero.astro) */
  .om-headline {
    font-size: 3.5rem;
    font-weight: 600;
    line-height: 1.15;
    text-wrap: balance;
    color: #ffffff;
    margin: 0;
  }

  @media (max-width: 768px) {
    .om-headline { font-size: 2.25rem; }
  }

  /* :global — span wstawiany przez tłumaczenia (innerHTML, bez atrybutu scope) */
  .om-headline :global(.om-headline-accent) {
    background: linear-gradient(135deg, #BAF52A 0%, #e8ff8a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ─── Lead text ─────────────────────────────────────────────────────────── */

  .om-lead {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    line-height: 1.75;
    color: rgba(255,255,255,0.55);
    margin: 0;
  }

  /* ─── Stats ─────────────────────────────────────────────────────────────── */

  .om-stats-grid {
    display: flex;
    align-items: flex-start;
    gap: 28px;
    flex-wrap: wrap;
  }

  .om-stat { flex-shrink: 0; }

  .om-stat-value {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
    background: linear-gradient(135deg, #BAF52A 0%, #e8ff8a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .om-stat-value--white {
    background: none;
    -webkit-text-fill-color: #ffffff;
    color: #ffffff;
  }

  .om-stat-label {
    font-size: 0.72rem;
    line-height: 1.5;
    color: rgba(255,255,255,0.5);
    margin: 6px 0 0 0;
  }

  .om-stat-divider {
    width: 1px;
    height: 40px;
    background: rgba(255,255,255,0.08);
    flex-shrink: 0;
    align-self: center;
  }

  /* ─── Photo ─────────────────────────────────────────────────────────────── */

  .om-photo-wrap { flex-shrink: 0; }

  .om-photo-frame {
    position: relative;
    width: 100%;
  }

  .om-photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,0.08);
    object-fit: cover;
  }

  .om-photo-frame::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 21px;
    background: linear-gradient(160deg, rgba(186,245,42,0.2), transparent 55%);
    z-index: -1;
    filter: blur(14px);
  }

  .om-photo-frame::after {
    content: '';
    position: absolute;
    top: 15%;
    bottom: 15%;
    left: -14px;
    width: 2px;
    background: linear-gradient(180deg, transparent, #BAF52A, transparent);
    border-radius: 9999px;
    opacity: 0.5;
  }

  /* „Poza projektami” — osobista notka zamiast cytatu */
  .om-personal-label {
    margin: 0 0 10px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #BAF52A;
  }
  .om-quote-text.om-personal-text { font-style: normal; }

  /* ─── Doświadczenie — oś czasu ──────────────────────────────────────────── */

  .om-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255,255,255,0.07);
  }

  .om-job {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

